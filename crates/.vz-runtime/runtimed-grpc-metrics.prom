# HELP vz_runtimed_grpc_requests_total Total gRPC requests handled by vz-runtimed.
# TYPE vz_runtimed_grpc_requests_total counter
# HELP vz_runtimed_grpc_request_duration_seconds gRPC request latency in seconds.
# TYPE vz_runtimed_grpc_request_duration_seconds histogram
# HELP vz_runtimed_btrfs_health_status Btrfs maintenance component health status (1=healthy,0=warning,-1=error,-2=unsupported).
# TYPE vz_runtimed_btrfs_health_status gauge
vz_runtimed_btrfs_health_status{component="balance"} -2
vz_runtimed_btrfs_health_status{component="scrub"} -2
# HELP vz_runtimed_btrfs_health_failures_total Total failed btrfs maintenance probe samples per component.
# TYPE vz_runtimed_btrfs_health_failures_total counter
vz_runtimed_btrfs_health_failures_total{component="balance"} 0
vz_runtimed_btrfs_health_failures_total{component="scrub"} 0
# HELP vz_runtimed_btrfs_health_last_probe_unix_seconds Unix timestamp of the most recent btrfs health probe by component.
# TYPE vz_runtimed_btrfs_health_last_probe_unix_seconds gauge
vz_runtimed_btrfs_health_last_probe_unix_seconds{component="balance"} 1775017169
vz_runtimed_btrfs_health_last_probe_unix_seconds{component="scrub"} 1775017169
