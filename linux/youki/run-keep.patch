+    fn fixture(pid: Option<i32>) -> Result<(TempDir, Container)> {
+        let root = tempdir()?;
+        let state = root.path().join("kept");
+        fs::create_dir(&state)?;
+        fs::write(state.join("resource-owner"), OWNER)?;
+        let container = Container::new("kept", ContainerStatus::Running, pid, root.path(), &state)?;
+        container.save()?;
+        Ok((root, container))
+    }
+
+    #[test]
+    fn test_vz_run_keep_state_and_exit_codes() -> Result<()> {
+        for code in [0, 37, 15] {
+            let (_root, mut container) = fixture(Some(std::process::id() as i32))?;
+            fs::write(container.root.join("youki_config.json"), CONFIG)?;
+            assert_eq!(finish_foreground(&mut container, true, Ok(code))?, code);
+            let stored = State::load(&container.root)?;
+            assert_eq!(stored.status, ContainerStatus::Stopped);
+            assert_eq!(stored.pid, None);
+            let loaded = Container::load(container.root.clone())?;
+            assert_eq!(loaded.status(), ContainerStatus::Stopped);
+            assert_eq!(loaded.id(), "kept");
+            assert_eq!(fs::read(container.root.join("resource-owner"))?, OWNER);
+            assert_eq!(fs::read(container.root.join("youki_config.json"))?, CONFIG);
+            assert_eq!(
+                loaded.spec()?.cgroup_path,
+                Path::new("/vz-keep-owned-fixture")
+            );
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn test_vz_run_keep_default_cleanup_and_error_order() -> Result<()> {
+        for code in [0, 37, 15] {
+            let (_root, mut container) = fixture(None)?;
+            assert_eq!(finish_foreground(&mut container, false, Ok(code))?, code);
+            assert!(!container.root.exists());
+        }
+        let (_root, mut container) = fixture(None)?;
+        let error =
+            finish_foreground(&mut container, false, Err(anyhow!("wait failed"))).unwrap_err();
+        assert_eq!(error.to_string(), "wait failed");
+        assert!(!container.root.exists());
+
+        // A state root replaced with a regular file makes actual delete fail.
+        // Cleanup failure must still take precedence over the waiter failure.
+        let (root, mut container) = fixture(None)?;
+        fs::rename(&container.root, root.path().join("preserved-state"))?;
+        fs::write(&container.root, OWNER)?;
+        let error =
+            finish_foreground(&mut container, false, Err(anyhow!("wait failed"))).unwrap_err();
+        assert_ne!(error.to_string(), "wait failed");
+        assert_eq!(fs::read(&container.root)?, OWNER);
+        Ok(())
+    }
