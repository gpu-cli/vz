+    #[test]
+    fn test_vz_run_keep_reaped_payload_lifecycle() -> Result<()> {
+        const SELECTOR: &str =
+            "commands::run::keep_tests::test_vz_run_keep_reaped_payload_lifecycle";
+        const ENV: &str = "VZ_RUN_KEEP_CHILD";
+        if let Ok(case) = std::env::var(ENV) {
+            let (keep, code) = match case.as_str() {
+                "keep-zero" => (true, 0),
+                "keep-nonzero" => (true, 37),
+                "default-zero" => (false, 0),
+                "default-nonzero" => (false, 37),
+                _ => anyhow::bail!("unexpected isolated child case"),
+            };
+            // This isolated test process blocks SIGCHLD before spawning so an
+            // already-exited child cannot race past the actual foreground wait.
+            SigSet::all().thread_block()?;
+            let child = Command::new("/bin/busybox")
+                .args(["sh", "-c", &format!("exit {code}")])
+                .spawn()?;
+            let pid = Pid::from_raw(child.id() as i32);
+            let (root, mut container) = fixture(Some(pid.as_raw()))?;
+            let waited = handle_foreground(pid);
+            assert_eq!(finish_foreground(&mut container, keep, waited)?, code);
+            assert_eq!(waitpid(pid, None), Err(nix::errno::Errno::ECHILD));
+            if keep {
+                assert_eq!(
+                    Container::load(container.root.clone())?.status(),
+                    ContainerStatus::Stopped
+                );
+                assert_eq!(State::load(&container.root)?.pid, None);
+                crate::commands::delete::delete(
+                    Delete {
+                        container_id: "kept".into(),
+                        force: false,
+                    },
+                    root.path().into(),
+                )?;
+            }
+            assert!(!container.root.exists());
+            return Ok(());
+        }
+        for case in [
+            "keep-zero",
+            "keep-nonzero",
+            "default-zero",
+            "default-nonzero",
+        ] {
+            let mut command = Command::new(std::env::current_exe()?);
+            command
+                .args(["--exact", SELECTOR, "--test-threads=1"])
+                .env(ENV, case)
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped());
+            // SAFETY: only async-signal-safe libc operations run between fork
+            // and exec. Block before exec so *all* test-harness threads inherit
+            // the mask; otherwise an unblocked harness thread can consume the
+            // process-directed SIGCHLD before the foreground waiter sees it.
+            unsafe {
+                command.pre_exec(|| {
+                    let mut set: nix::libc::sigset_t = std::mem::zeroed();
+                    if nix::libc::sigfillset(&mut set) != 0 {
+                        return Err(std::io::Error::last_os_error());
+                    }
+                    let code = nix::libc::pthread_sigmask(
+                        nix::libc::SIG_SETMASK,
+                        &set,
+                        std::ptr::null_mut(),
+                    );
+                    if code != 0 {
+                        return Err(std::io::Error::from_raw_os_error(code));
+                    }
+                    Ok(())
+                });
+            }
+            let mut child = command.spawn()?;
+            let deadline = Instant::now() + Duration::from_secs(10);
+            loop {
+                if child.try_wait()?.is_some() {
+                    break;
+                }
+                if Instant::now() >= deadline {
+                    child.kill()?;
+                    child.wait()?;
+                    anyhow::bail!("bounded foreground child timed out: {case}");
+                }
+                std::thread::sleep(Duration::from_millis(10));
+            }
+            let output = child.wait_with_output()?;
+            assert!(
+                output.status.success(),
+                "{case}: stdout={} stderr={}",
+                String::from_utf8_lossy(&output.stdout),
+                String::from_utf8_lossy(&output.stderr)
+            );
+            assert!(output.stderr.is_empty());
+        }
+        Ok(())
+    }
