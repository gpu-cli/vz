+// The foreground waiter has reaped init only on Ok. Keep transfers cleanup to
+// the caller (including cgroups and poststop hooks); a failed wait must not turn
+// uncertain process ownership into a fabricated stopped state or deletion.
+fn finish_foreground(container: &mut Container, keep: bool, result: Result<i32>) -> Result<i32> {
+    if !keep {
+        // Preserve the original default cleanup and error precedence exactly.
+        container.delete(true)?;
+        return result;
+    }
+    let exit_code = result?;
+    // The reaped PID can be reused. Persist its absence so future state/delete
+    // operations cannot mistake an unrelated process for the container init.
+    container.state.pid = None;
+    container.set_status(ContainerStatus::Stopped).save()?;
+    Ok(exit_code)
+}
