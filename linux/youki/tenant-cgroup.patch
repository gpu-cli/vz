+    #[test]
+    fn test_vz_tenant_cgroup_parser_and_owned_subtree() {
+        assert_eq!(
+            unified_membership("2:cpu:/legacy\n0::/owned/init:colon\n").unwrap(),
+            "/owned/init:colon"
+        );
+        for bad in [
+            "",
+            "0::/owned\n0::/owned\n",
+            "0:cpu:/owned\n",
+            "0::owned\n",
+            "0::/owned/../other\n",
+            "0::/owned//init\n",
+            "0::/owned/.\n",
+            "0::/owned/\n",
+            "0::/owned\r\n",
+            "broken\n",
+            "0::/owned\0\n",
+        ] {
+            assert!(unified_membership(bad).is_err(), "accepted {bad:?}");
+        }
+        assert!(unified_membership(&format!("0::/{}", "a".repeat(8192))).is_err());
+        assert!(descendant(Path::new("/owned"), "/owned").unwrap().is_none());
+        assert_eq!(
+            descendant(Path::new("/owned"), "/owned/init").unwrap(),
+            Some("/owned/init".into())
+        );
+        for outside in ["/", "/owned-evil/init", "/other/init"] {
+            assert!(descendant(Path::new("/owned"), outside).is_err());
+        }
+    }
+
+    #[test]
+    fn test_vz_tenant_cgroup_routing_preserves_explicit_and_nonfilesystem() {
+        // Explicit '/' and explicit relative subgroups both map to `true` at
+        // tenant_builder's Option::is_some boundary; neither is redirected.
+        for subgroup in [Some("/"), Some("child")] {
+            assert!(
+                TenantCgroup::capture(-1, Some(Path::new("/owned")), subgroup.is_some(), false, 0)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+        assert!(
+            TenantCgroup::capture(-1, Some(Path::new("/owned")), false, true, 0)
+                .unwrap()
+                .is_none()
+        );
+        for path in [
+            None,
+            Some(Path::new(":youki:default")),
+            Some(Path::new("relative")),
+            Some(Path::new("/")),
+        ] {
+            assert!(
+                TenantCgroup::capture(-1, path, false, false, 0)
+                    .unwrap()
+                    .is_none()
+            );
+        }
+        let fixture = fixture();
+        assert!(!unified_fs(fixture.selected.root.as_raw_fd()).unwrap());
+        assert!(selected_base(Some(Path::new("/owned/../other")), false, false).is_err());
+        assert!(TenantCgroup::capture(-1, Some(Path::new("/owned")), false, false, -1).is_err());
+    }
+
+    #[test]
+    fn test_vz_tenant_cgroup_base_success_and_only_ebusy_fallback() {
+        let fixture = fixture();
+        let base = fixture.selected.base_procs.as_raw_fd();
+        let leaf = fixture.selected.leaf_procs.as_raw_fd();
+        for error in [
+            None,
+            Some(libc::EBUSY),
+            Some(libc::EACCES),
+            Some(libc::EROFS),
+            Some(libc::EOPNOTSUPP),
+            Some(libc::ENOENT),
+            Some(libc::EINTR),
+        ] {
+            let mut calls = Vec::new();
+            let result = fixture
+                .selected
+                .attach_with(fixture.proc.as_raw_fd(), |fd| {
+                    calls.push(fd);
+                    if fd == base
+                        && let Some(error) = error
+                    {
+                        return Err(io::Error::from_raw_os_error(error));
+                    }
+                    Ok(())
+                });
+            assert_eq!(
+                calls,
+                if error == Some(libc::EBUSY) {
+                    vec![base, leaf]
+                } else {
+                    vec![base]
+                }
+            );
+            assert_eq!(
+                result.is_ok(),
+                error.is_none() || error == Some(libc::EBUSY)
+            );
+        }
+        let mut calls = Vec::new();
+        let error = fixture
+            .selected
+            .attach_with(fixture.proc.as_raw_fd(), |fd| {
+                calls.push(fd);
+                Err(io::Error::from_raw_os_error(if fd == base {
+                    libc::EBUSY
+                } else {
+                    libc::EPERM
+                }))
+            })
+            .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::EPERM));
+        assert_eq!(calls, [base, leaf]);
+        assert!(
+            fixture
+                .selected
+                .attach(fixture.proc.as_raw_fd(), Pid::from_raw(0))
+                .is_err()
+        );
+    }
