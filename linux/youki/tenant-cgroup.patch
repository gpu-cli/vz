+//! Locally authored cgroupfs-v2 exec correction. Keep the configured cgroup
+//! when it accepts the task. EBUSY alone permits following init into a pinned,
+//! strict descendant, without creating groups, enabling controllers, or moving
+//! any other process. Explicit subgroups, systemd, v1, and relative/default OCI
+//! paths retain their existing routing. Acquisition cannot authenticate a stale
+//! persisted numeric PID before TenantRoot pins its proc directory.
+use std::ffi::CString;
+use std::fs::File;
+use std::io::{self, Read};
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::path::{Path, PathBuf};
+
+use nix::unistd::Pid;
+
+use super::tenant_root::open_at;
+
+const LIMIT: u64 = 8192;
+const DIR: i32 = libc::O_PATH | libc::O_DIRECTORY | libc::O_NOFOLLOW;
+
+pub(super) struct TenantCgroup {
+    root: OwnedFd,
+    base: OwnedFd,
+    leaf: OwnedFd,
+    base_procs: OwnedFd,
+    leaf_procs: OwnedFd,
+    base_path: PathBuf,
+    leaf_path: PathBuf,
+    membership: String,
+    floor: i32,
+}
+
+fn clean_path(value: &str) -> io::Result<PathBuf> {
+    if !value.starts_with('/')
+        || value.bytes().any(|c| c < 32 || c == 127)
+        || (value != "/"
+            && value[1..]
+                .split('/')
+                .any(|part| matches!(part, "" | "." | "..")))
+    {
+        return Err(io::Error::other("noncanonical unified cgroup path"));
+    }
+    Ok(PathBuf::from(value))
+}
+
+fn unified_membership(raw: &str) -> io::Result<String> {
+    if raw.len() > LIMIT as usize || raw.contains('\r') {
+        return Err(io::Error::other("invalid or oversized proc cgroup record"));
+    }
+    let mut unified = None;
+    for line in raw.lines() {
+        let mut fields = line.splitn(3, ':');
+        let hierarchy = fields.next();
+        let controllers = fields.next();
+        let path = fields
+            .next()
+            .ok_or_else(|| io::Error::other("malformed proc cgroup record"))?;
+        if hierarchy == Some("0") {
+            if controllers != Some("") || unified.is_some() {
+                return Err(io::Error::other("ambiguous unified cgroup record"));
+            }
+            clean_path(path)?;
+            unified = Some(path.to_owned());
+        }
+    }
+    unified.ok_or_else(|| io::Error::other("missing unified cgroup record"))
+}
+
+fn read_membership(proc: RawFd, floor: i32) -> io::Result<String> {
+    let fd = open_at(proc, c"cgroup", libc::O_RDONLY | libc::O_NOFOLLOW, floor)?;
+    let mut raw = String::new();
+    File::from(fd).take(LIMIT + 1).read_to_string(&mut raw)?;
+    unified_membership(&raw)
+}
+
+fn selected_base(
+    path: Option<&Path>,
+    explicit: bool,
+    systemd: bool,
+) -> io::Result<Option<PathBuf>> {
+    if explicit || systemd {
+        return Ok(None);
+    }
+    let Some(path) = path else { return Ok(None) };
+    if !path.is_absolute() || path == Path::new("/") {
+        return Ok(None);
+    }
+    clean_path(
+        path.to_str()
+            .ok_or_else(|| io::Error::other("non-UTF8 cgroup path"))?,
+    )
+    .map(Some)
+}
+
+fn descendant(base: &Path, member: &str) -> io::Result<Option<PathBuf>> {
+    let path = clean_path(member)?;
+    if !path.starts_with(base) {
+        return Err(io::Error::other(
+            "init cgroup is outside the original owned subtree",
+        ));
+    }
+    Ok((path != base).then_some(path))
+}
+
+fn walk(root: RawFd, path: &Path, floor: i32) -> io::Result<OwnedFd> {
+    let mut directory = open_at(root, c".", DIR, floor)?;
+    for part in path.components() {
+        if let std::path::Component::Normal(name) = part {
+            let name = CString::new(name.as_encoded_bytes())
+                .map_err(|_| io::Error::other("NUL in cgroup path"))?;
+            directory = open_beneath(directory.as_raw_fd(), &name, DIR, floor)?;
+        } else if !matches!(part, std::path::Component::RootDir) {
+            return Err(io::Error::other("noncanonical cgroup traversal"));
+        }
+    }
+    Ok(directory)
+}
+
+fn open_beneath(dir: RawFd, name: &std::ffi::CStr, flags: i32, floor: i32) -> io::Result<OwnedFd> {
+    #[repr(C)]
+    struct OpenHow {
+        flags: u64,
+        mode: u64,
+        resolve: u64,
+    }
+    let how = OpenHow {
+        flags: (flags | libc::O_CLOEXEC | libc::O_NOFOLLOW) as u64,
+        mode: 0,
+        // RESOLVE_NO_XDEV | NO_MAGICLINKS | NO_SYMLINKS | BENEATH.
+        // Unlike O_NOFOLLOW, NO_XDEV also rejects same-filesystem bind mounts.
+        resolve: 0x01 | 0x02 | 0x04 | 0x08,
+    };
+    // SAFETY: valid borrowed dir fd, NUL-terminated name and initialized Linux
+    // open_how ABI buffer. No create operation; successful result is a new fd.
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_openat2,
+            dir,
+            name.as_ptr(),
+            &how,
+            std::mem::size_of::<OpenHow>(),
+        )
+    };
+    if result < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let fd = unsafe { OwnedFd::from_raw_fd(result as RawFd) };
+    // SAFETY: fd is live and fcntl creates a distinct owned CLOEXEC descriptor.
+    let duplicate = unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_DUPFD_CLOEXEC, floor) };
+    if duplicate < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { OwnedFd::from_raw_fd(duplicate) })
+}
+
+fn identity(fd: RawFd) -> io::Result<(libc::dev_t, libc::ino_t)> {
+    let mut info = std::mem::MaybeUninit::<libc::stat>::uninit();
+    // SAFETY: borrowed live fd; successful fstat initializes the output.
+    if unsafe { libc::fstat(fd, info.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let info = unsafe { info.assume_init() };
+    if info.st_nlink == 0 {
+        return Err(io::Error::other("cgroup was removed"));
+    }
+    Ok((info.st_dev, info.st_ino))
+}
+
+fn unified_fs(fd: RawFd) -> io::Result<bool> {
+    let mut info = std::mem::MaybeUninit::<libc::statfs>::uninit();
+    // SAFETY: borrowed live fd; successful fstatfs initializes the output.
+    if unsafe { libc::fstatfs(fd, info.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { info.assume_init() }.f_type as u64 == libc::CGROUP2_SUPER_MAGIC as u64)
+}
+
+impl TenantCgroup {
+    pub(super) fn capture(
+        proc: RawFd,
+        path: Option<&Path>,
+        explicit: bool,
+        systemd: bool,
+        preserve_fds: i32,
+    ) -> io::Result<Option<Self>> {
+        let Some(base) = selected_base(path, explicit, systemd)? else {
+            return Ok(None);
+        };
+        let floor = preserve_fds
+            .checked_add(3)
+            .filter(|n| *n >= 3)
+            .ok_or_else(|| io::Error::other("invalid preserved fd count"))?;
+        // Mount crossings are needed to reach the cgroup mount, but forbidden
+        // for all traversal below this pinned and filesystem-verified root.
+        let mut root = open_at(libc::AT_FDCWD, c"/", DIR, floor)?;
+        for part in [c"sys", c"fs", c"cgroup"] {
+            root = open_at(root.as_raw_fd(), part, DIR, floor)?;
+        }
+        if !unified_fs(root.as_raw_fd())? {
+            return Ok(None);
+        }
+        let membership = read_membership(proc, floor)?;
+        let Some(leaf) = descendant(&base, &membership)? else {
+            return Ok(None);
+        };
+        let selected = Self::pin(root, base, leaf, membership, floor)?;
+        if !unified_fs(selected.base.as_raw_fd())? || !unified_fs(selected.leaf.as_raw_fd())? {
+            return Err(io::Error::other("selected cgroup is not cgroupfs v2"));
+        }
+        selected.verify(proc)?;
+        Ok(Some(selected))
+    }
+
+    fn pin(
+        root: OwnedFd,
+        base_path: PathBuf,
+        leaf_path: PathBuf,
+        membership: String,
+        floor: i32,
+    ) -> io::Result<Self> {
+        let base = walk(root.as_raw_fd(), &base_path, floor)?;
+        let leaf = walk(root.as_raw_fd(), &leaf_path, floor)?;
+        let base_procs = open_beneath(
+            base.as_raw_fd(),
+            c"cgroup.procs",
+            libc::O_WRONLY | libc::O_NOFOLLOW,
+            floor,
+        )?;
+        let leaf_procs = open_beneath(
+            leaf.as_raw_fd(),
+            c"cgroup.procs",
+            libc::O_WRONLY | libc::O_NOFOLLOW,
+            floor,
+        )?;
+        Ok(Self {
+            root,
+            base,
+            leaf,
+            base_procs,
+            leaf_procs,
+            base_path,
+            leaf_path,
+            membership,
+            floor,
+        })
+    }
+
+    fn verify(&self, proc: RawFd) -> io::Result<()> {
+        if read_membership(proc, self.floor)? != self.membership {
+            return Err(io::Error::other(
+                "init cgroup changed during exec admission",
+            ));
+        }
+        for (path, held) in [(&self.base_path, &self.base), (&self.leaf_path, &self.leaf)] {
+            let current = walk(self.root.as_raw_fd(), path, self.floor)?;
+            if identity(current.as_raw_fd())? != identity(held.as_raw_fd())? {
+                return Err(io::Error::other("selected cgroup identity changed"));
+            }
+        }
+        for (directory, held) in [
+            (&self.base, &self.base_procs),
+            (&self.leaf, &self.leaf_procs),
+        ] {
+            let current = open_beneath(
+                directory.as_raw_fd(),
+                c"cgroup.procs",
+                libc::O_WRONLY | libc::O_NOFOLLOW,
+                self.floor,
+            )?;
+            if identity(current.as_raw_fd())? != identity(held.as_raw_fd())? {
+                return Err(io::Error::other("selected cgroup.procs identity changed"));
+            }
+        }
+        Ok(())
+    }
+
+    pub(super) fn attach(&self, proc: RawFd, pid: Pid) -> io::Result<()> {
+        if pid.as_raw() <= 0 {
+            return Err(io::Error::other("invalid exec pid"));
+        }
+        self.attach_with(proc, |fd| {
+            let value = pid.as_raw().to_string();
+            // SAFETY: borrowed live cgroup.procs fd and initialized byte slice.
+            // Exactly one write: do not retry/continue a partial kernel request.
+            let written = unsafe { libc::write(fd, value.as_ptr().cast(), value.len()) };
+            if written < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            if written as usize != value.len() {
+                return Err(io::Error::other("short cgroup.procs write"));
+            }
+            Ok(())
+        })
+    }
+
+    fn attach_with(
+        &self,
+        proc: RawFd,
+        mut write: impl FnMut(RawFd) -> io::Result<()>,
+    ) -> io::Result<()> {
+        self.verify(proc)?;
+        match write(self.base_procs.as_raw_fd()) {
+            Ok(()) => (),
+            Err(error) if error.raw_os_error() == Some(libc::EBUSY) => {
+                self.verify(proc)?;
+                write(self.leaf_procs.as_raw_fd())?;
+            }
+            Err(error) => return Err(error),
+        }
+        self.verify(proc)
+    }
+}
+
