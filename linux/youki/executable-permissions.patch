+    fn executable_permission_spec(command: String, search_path: &Path) -> Spec {
+        let mut process = oci_spec::runtime::Process::default();
+        process.set_args(Some(vec![command]));
+        process.set_env(Some(vec![format!("PATH={}", search_path.display())]));
+        let mut spec = Spec::default();
+        spec.set_process(Some(process));
+        spec
+    }
