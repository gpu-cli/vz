+        std::fs::write(&path, b"permission preflight fixture").expect("regular fixture file");
+        for &(mode, expected) in EXECUTABLE_PERMISSION_CASES {
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(mode))
+                .expect("set exact fixture permissions");
