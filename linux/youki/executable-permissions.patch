+            let detail = match error {
+                ExecutorError::Execution(source) => source.to_string(),
+                other => panic!("expected actual kernel execution error, got {other:?}"),
+            };
+            assert!(
+                detail.starts_with("error 'EACCES: Permission denied' executing '"),
+                "kernel must reject 0600 execution with EACCES: {detail}"
+            );
+            println!("VZ_EXECUTABLE_PERMISSIONS_KERNEL_ERROR={detail}");
+            println!("{DENIED}");
