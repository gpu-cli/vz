+    fn test_vz_runtime_audit_typed_operations_and_secret_exclusion() {
+        let cid = "b".repeat(64);
+        let secret = "private-payload-that-must-never-enter-audit";
+        let opts = Opts::try_parse_from([
+            "youki",
+            "exec",
+            "--env",
+            &format!("SECRET={secret}"),
+            &cid,
+            "/bin/echo",
+            secret,
+        ])
+        .unwrap();
+        let selected = Selection::from_opts(&opts);
+        assert_eq!(selected.operation, "exec");
+        assert_eq!(selected.container_id.as_deref(), Some(cid.as_str()));
+        let root = setup();
+        let mut audit = Audit::begin_at(root.path().to_owned(), selected);
+        audit.finish(false, -1);
+        let records = rows(root.path());
+        assert_eq!(records[1].exit_code, Some(255));
+        assert!(
+            !fs::read_to_string(root.path().join("events.jsonl"))
+                .unwrap()
+                .contains(secret)
+        );
+        for operation in [
+            "create", "start", "state", "delete", "pause", "resume", "events", "ps", "run",
+            "update",
+        ] {
+            let opts = Opts::try_parse_from(["youki", operation, &cid]).unwrap();
+            assert_eq!(Selection::from_opts(&opts).operation, operation);
+        }
+        // Upstream exposes the misspelled CommonCmd::Checkpointt as its CLI
+        // spelling. Audit records the semantic operation, not a CLI repair.
+        let checkpoint = Opts::try_parse_from(["youki", "checkpointt", &cid]).unwrap();
+        assert_eq!(Selection::from_opts(&checkpoint).operation, "checkpoint");
+        assert!(Opts::try_parse_from(["youki", "checkpoint", &cid]).is_err());
+        for operation in ["features", "list", "spec", "info"] {
+            let opts = Opts::try_parse_from(["youki", operation]).unwrap();
+            assert!(Selection::from_opts(&opts).container_id.is_none());
+        }
+        let kill = Opts::try_parse_from(["youki", "kill", &cid, "TERM"]).unwrap();
+        assert_eq!(Selection::from_opts(&kill).operation, "kill");
+        let completion = Opts::try_parse_from(["youki", "completion", "--shell", "bash"]).unwrap();
+        assert_eq!(Selection::from_opts(&completion).operation, "completion");
+        assert_eq!(
+            Selection::from_opts(&Opts::try_parse_from(["youki"]).unwrap()).operation,
+            "help"
+        );
+        assert_eq!(
+            Selection::from_opts(&Opts::try_parse_from(["youki", "--version"]).unwrap()).operation,
+            "version"
+        );
+    }
