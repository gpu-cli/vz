+    #[test]
+    fn test_vz_runtime_audit_unsafe_paths_and_quota() {
+        for case in [
+            "symlink",
+            "hardlink",
+            "fifo",
+            "mode",
+            "quota",
+            "ancestor",
+            "owner",
+            "marker-symlink",
+            "status-hardlink",
+            "boot",
+        ] {
+            let root = setup();
+            let path = root.path().join("events.jsonl");
+            match case {
+                "symlink" => {
+                    fs::remove_file(&path).unwrap();
+                    symlink("status", &path).unwrap();
+                }
+                "hardlink" => fs::hard_link(&path, root.path().join("extra")).unwrap(),
+                "fifo" => {
+                    fs::remove_file(&path).unwrap();
+                    let c = CString::new(path.to_str().unwrap()).unwrap();
+                    assert_eq!(unsafe { libc::mkfifo(c.as_ptr(), 0o600) }, 0);
+                }
+                "mode" => fs::set_permissions(&path, fs::Permissions::from_mode(0o666)).unwrap(),
+                "quota" => File::options()
+                    .write(true)
+                    .open(&path)
+                    .unwrap()
+                    .set_len(LIMIT + 1)
+                    .unwrap(),
+                "ancestor" => {
+                    fs::set_permissions(root.path(), fs::Permissions::from_mode(0o777)).unwrap()
+                }
+                "owner" => {
+                    let c = CString::new(path.to_str().unwrap()).unwrap();
+                    // SAFETY: private native fixture path; test runs as root.
+                    assert_eq!(unsafe { libc::chown(c.as_ptr(), 10001, 10001) }, 0);
+                }
+                "marker-symlink" => {
+                    fs::remove_file(root.path().join("enrollment.json")).unwrap();
+                    symlink("status", root.path().join("enrollment.json")).unwrap();
+                }
+                "status-hardlink" => {
+                    fs::hard_link(root.path().join("status"), root.path().join("extra")).unwrap()
+                }
+                "boot" => {
+                    fs::write(
+                        root.path().join("enrollment.json"),
+                        serde_json::to_vec(&Enrollment {
+                            schema_version: 1,
+                            session_id: "a".repeat(64),
+                            boot_id: "00000000-0000-0000-0000-000000000000".to_owned(),
+                        })
+                        .unwrap(),
+                    )
+                    .unwrap();
+                }
+                _ => unreachable!(),
+            }
+            let mut audit = Audit::begin_at(root.path().to_owned(), select());
+            assert!(audit.active.is_none(), "{case}");
+            audit.finish(true, 0); // diagnostic failure never blocks operation completion
+            if !matches!(case, "ancestor" | "status-hardlink") {
+                assert_eq!(
+                    fs::read(root.path().join("status")).unwrap(),
+                    b"incomplete\n"
+                );
+            }
+        }
+        let root = setup();
+        let directory = open_root(root.path()).unwrap().unwrap();
+        let held = regular(&directory, "events.jsonl", libc::O_RDWR, LIMIT).unwrap();
+        lock(&held).unwrap();
+        let start = Instant::now();
+        let mut audit = Audit::begin_at(root.path().to_owned(), select());
+        assert!(audit.active.is_none());
+        assert!(start.elapsed() < Duration::from_secs(5));
+        assert!(crate::return_with_audit(&mut audit, Ok(())).is_ok());
+        assert_eq!(
+            fs::read(root.path().join("status")).unwrap(),
+            b"incomplete\n"
+        );
+    }
