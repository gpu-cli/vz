+    #[test]
+    fn test_vz_runtime_audit_enrollment_disabled_and_identity() {
+        let missing = tempfile::tempdir().unwrap();
+        let mut disabled = Audit::begin_at(missing.path().join("not-created"), select());
+        disabled.finish(true, 37);
+        assert!(!missing.path().join("not-created").exists());
+        let root = setup();
+        let mut audit = Audit::begin_at(root.path().to_owned(), select());
+        assert!(audit.active.is_some());
+        no_owned_fds(root.path());
+        audit.finish(true, 37);
+        no_owned_fds(root.path());
+        let records = rows(root.path());
+        assert_eq!(records.len(), 2);
+        assert_eq!(records[0].pid, std::process::id());
+        assert_eq!(records[0].starttime_ticks, birth().unwrap());
+        assert_eq!(records[0].boot_id, boot_id().unwrap());
+        assert_eq!(
+            records[0].invocation_id,
+            format!(
+                "{}:{}:{}",
+                records[0].pid, records[0].starttime_ticks, records[0].monotonic_ns
+            )
+        );
+        assert_eq!(records[1].invocation_id, records[0].invocation_id);
+        assert_eq!(records[1].exit_code, Some(37));
+        assert_eq!(records[1].outcome.as_deref(), Some("ok"));
+        unchanged_status(root.path());
+    }
