+    fn setup() -> tempfile::TempDir {
+        assert_eq!(
+            unsafe { libc::geteuid() },
+            0,
+            "native audit fixture requires root"
+        );
+        let root = tempfile::tempdir().unwrap();
+        fs::set_permissions(root.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        for (name, bytes) in [
+            (
+                "enrollment.json",
+                serde_json::to_vec(&Enrollment {
+                    schema_version: 1,
+                    session_id: "a".repeat(64),
+                    boot_id: boot_id().unwrap(),
+                })
+                .unwrap(),
+            ),
+            ("events.jsonl", Vec::new()),
+            ("status", b"complete\n".to_vec()),
+        ] {
+            fs::write(root.path().join(name), bytes).unwrap();
+            fs::set_permissions(root.path().join(name), fs::Permissions::from_mode(0o600)).unwrap();
+        }
+        root
+    }
+    fn select() -> Selection {
+        Selection {
+            operation: "exec",
+            container_id: Some("b".repeat(64)),
+        }
+    }
+    fn rows(root: &Path) -> Vec<Record> {
+        fs::read_to_string(root.join("events.jsonl"))
+            .unwrap()
+            .lines()
+            .map(|s| serde_json::from_str(s).unwrap())
+            .collect()
+    }
+    fn unchanged_status(root: &Path) {
+        assert_eq!(fs::read(root.join("status")).unwrap(), b"complete\n");
+    }
+    fn no_owned_fds(root: &Path) {
+        for entry in fs::read_dir("/proc/self/fd").unwrap() {
+            if let Ok(target) = fs::read_link(entry.unwrap().path()) {
+                assert!(!target.starts_with(root), "audit FD survived operation");
+            }
+        }
+    }
