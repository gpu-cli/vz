+//! Opt-in diagnostic audit, not an authorization or OCI success dependency.
+//! Enrollment/files are created only by an authenticated external controller.
+//! No audit FD survives begin/finish into dispatch, fork, hooks, or payload exec.
+//! Missing pairs, sticky incomplete status, or any invalid byte invalidate proof.
+use std::ffi::CString;
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom, Write};
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::fs::MetadataExt;
+use std::path::{Component, Path, PathBuf};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use nix::libc;
+use serde::{Deserialize, Serialize};
+
+use crate::{Opts, YoukiSubCommand};
+use liboci_cli::{CommonCmd, StandardCmd};
+
+const ROOT: &str = "/var/lib/docker/runtime-audit";
+const LIMIT: u64 = 16 * 1024 * 1024;
+const RECORD_LIMIT: usize = 2048;
+const WARNING: &str = "youki: runtime audit incomplete";
+
+fn invalid() -> io::Error {
+    io::Error::from_raw_os_error(libc::EINVAL)
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Enrollment {
+    schema_version: u8,
+    session_id: String,
+    boot_id: String,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Record {
+    schema_version: u8,
+    sequence: u64,
+    event: String,
+    session_id: String,
+    boot_id: String,
+    invocation_id: String,
+    operation: String,
+    container_id: Option<String>,
+    pid: u32,
+    starttime_ticks: u64,
+    monotonic_ns: u64,
+    wall_time_ns: u64,
+    outcome: Option<String>,
+    exit_code: Option<u8>,
+}
+
+#[derive(Clone)]
+struct Selection {
+    operation: &'static str,
+    container_id: Option<String>,
+}
+
+impl Selection {
+    fn from_opts(opts: &Opts) -> Self {
+        let (operation, cid) = if opts.version {
+            ("version", None)
+        } else {
+            match opts.subcmd.as_ref() {
+                Some(YoukiSubCommand::Standard(cmd)) => match cmd.as_ref() {
+                    StandardCmd::Create(c) => ("create", Some(&c.container_id)),
+                    StandardCmd::Start(c) => ("start", Some(&c.container_id)),
+                    StandardCmd::Kill(c) => ("kill", Some(&c.container_id)),
+                    StandardCmd::Delete(c) => ("delete", Some(&c.container_id)),
+                    StandardCmd::State(c) => ("state", Some(&c.container_id)),
+                },
+                Some(YoukiSubCommand::Common(cmd)) => match cmd.as_ref() {
+                    CommonCmd::Checkpointt(c) => ("checkpoint", Some(&c.container_id)),
+                    CommonCmd::Events(c) => ("events", Some(&c.container_id)),
+                    CommonCmd::Exec(c) => ("exec", Some(&c.container_id)),
+                    CommonCmd::Pause(c) => ("pause", Some(&c.container_id)),
+                    CommonCmd::Ps(c) => ("ps", Some(&c.container_id)),
+                    CommonCmd::Resume(c) => ("resume", Some(&c.container_id)),
+                    CommonCmd::Run(c) => ("run", Some(&c.container_id)),
+                    CommonCmd::Update(c) => ("update", Some(&c.container_id)),
+                    CommonCmd::Features(_) => ("features", None),
+                    CommonCmd::List(_) => ("list", None),
+                    CommonCmd::Spec(_) => ("spec", None),
+                },
+                Some(YoukiSubCommand::Info(_)) => ("info", None),
+                Some(YoukiSubCommand::Completion(_)) => ("completion", None),
+                None => ("help", None),
+            }
+        };
+        Self {
+            operation,
+            container_id: cid.cloned(),
+        }
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+struct Identity(u64, u64);
+
+fn identity(file: &File) -> io::Result<Identity> {
+    let meta = file.metadata()?;
+    Ok(Identity(meta.dev(), meta.ino()))
+}
+
+fn openat(directory: &File, name: &str, flags: i32) -> io::Result<File> {
+    let name = CString::new(name).map_err(|_| invalid())?;
+    // SAFETY: valid borrowed directory FD and NUL-terminated component; O_CREAT
+    // is never supplied. NONBLOCK ensures a substituted FIFO cannot hang open.
+    let fd = unsafe {
+        libc::openat(
+            directory.as_raw_fd(),
+            name.as_ptr(),
+            flags | libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful openat returned a new owned descriptor.
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+fn open_root(path: &Path) -> io::Result<Option<File>> {
+    if !path.is_absolute() {
+        return Err(invalid());
+    }
+    let mut directory = File::open("/")?;
+    for part in path.components() {
+        let Component::Normal(part) = part else {
+            if part == Component::RootDir {
+                continue;
+            }
+            return Err(invalid());
+        };
+        let next = match openat(
+            &directory,
+            part.to_str().ok_or_else(invalid)?,
+            libc::O_RDONLY | libc::O_DIRECTORY,
+        ) {
+            Ok(file) => file,
+            Err(error) if error.raw_os_error() == Some(libc::ENOENT) => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        let meta = next.metadata()?;
+        // Sticky root-owned ancestors also support isolated native /tmp tests:
+        // unprivileged peers cannot replace a root-owned child there.
+        if meta.uid() != 0 || (meta.mode() & 0o022 != 0 && meta.mode() & 0o1000 == 0) {
+            return Err(invalid());
+        }
+        directory = next;
+    }
+    if directory.metadata()?.mode() & 0o7777 != 0o700 {
+        return Err(invalid());
+    }
+    Ok(Some(directory))
+}
+
+fn regular(directory: &File, name: &str, flags: i32, maximum: u64) -> io::Result<File> {
+    let file = openat(directory, name, flags)?;
+    let meta = file.metadata()?;
+    if !meta.is_file()
+        || meta.uid() != 0
+        || meta.mode() & 0o7777 != 0o600
+        || meta.nlink() != 1
+        || meta.len() > maximum
+    {
+        return Err(invalid());
+    }
+    Ok(file)
+}
+
+fn bounded(file: &mut File, limit: usize) -> io::Result<Vec<u8>> {
+    let before = file.metadata()?;
+    let mut bytes = Vec::new();
+    (&mut *file)
+        .take(limit as u64 + 1)
+        .read_to_end(&mut bytes)?;
+    let after = file.metadata()?;
+    if bytes.len() > limit
+        || (
+            before.dev(),
+            before.ino(),
+            before.len(),
+            before.mtime(),
+            before.mtime_nsec(),
+            before.ctime(),
+            before.ctime_nsec(),
+        ) != (
+            after.dev(),
+            after.ino(),
+            after.len(),
+            after.mtime(),
+            after.mtime_nsec(),
+            after.ctime(),
+            after.ctime_nsec(),
+        )
+    {
+        return Err(invalid());
+    }
+    Ok(bytes)
+}
+
+fn boot_id() -> io::Result<String> {
+    let raw = bounded(&mut File::open("/proc/sys/kernel/random/boot_id")?, 37)?;
+    let value = std::str::from_utf8(&raw).map_err(|_| invalid())?;
+    let value = value.strip_suffix('\n').ok_or_else(invalid)?;
+    if value.len() != 36
+        || value.bytes().enumerate().any(|(i, b)| {
+            if [8, 13, 18, 23].contains(&i) {
+                b != b'-'
+            } else {
+                !b.is_ascii_hexdigit() || b.is_ascii_uppercase()
+            }
+        })
+        || value == "00000000-0000-0000-0000-000000000000"
+    {
+        return Err(invalid());
+    }
+    Ok(value.to_owned())
+}
+
+fn birth() -> io::Result<u64> {
+    let raw = bounded(&mut File::open("/proc/self/stat")?, 4096)?;
+    let text = std::str::from_utf8(&raw).map_err(|_| invalid())?;
+    let tail = text.rsplit_once(") ").ok_or_else(invalid)?.1;
+    let value = tail
+        .split_whitespace()
+        .nth(19)
+        .ok_or_else(invalid)?
+        .parse::<u64>()
+        .map_err(|_| invalid())?;
+    if value == 0 {
+        return Err(invalid());
+    }
+    Ok(value)
+}
+
+fn clock(kind: libc::clockid_t) -> io::Result<u64> {
+    let mut time = libc::timespec {
+        tv_sec: 0,
+        tv_nsec: 0,
+    };
+    // SAFETY: clock_gettime writes one valid stack timespec, no retained pointer.
+    if unsafe { libc::clock_gettime(kind, &mut time) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if time.tv_sec < 0 || !(0..1_000_000_000).contains(&time.tv_nsec) {
+        return Err(invalid());
+    }
+    (time.tv_sec as u64)
+        .checked_mul(1_000_000_000)
+        .and_then(|v| v.checked_add(time.tv_nsec as u64))
+        .filter(|v| *v > 0)
+        .ok_or_else(invalid)
+}
+
+fn lock(file: &File) -> io::Result<()> {
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        // SAFETY: flock acts only on this freshly opened, validated owned FD.
+        if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } == 0 {
+            return Ok(());
+        }
+        let error = io::Error::last_os_error();
+        if error.raw_os_error() != Some(libc::EWOULDBLOCK) || Instant::now() >= deadline {
+            return Err(error);
+        }
+        thread::sleep(Duration::from_millis(10));
+    }
+}
+
+fn enrollment(directory: &File) -> io::Result<Option<Enrollment>> {
+    let mut file = match regular(directory, "enrollment.json", libc::O_RDONLY, 512) {
+        Ok(file) => file,
+        Err(error) if error.raw_os_error() == Some(libc::ENOENT) => return Ok(None),
+        Err(error) => return Err(error),
+    };
+    let value: Enrollment =
+        serde_json::from_slice(&bounded(&mut file, 512)?).map_err(|_| invalid())?;
+    if value.schema_version != 1
+        || value.session_id.len() != 64
+        || !value
+            .session_id
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || value.boot_id != boot_id()?
+    {
+        return Err(invalid());
+    }
+    Ok(Some(value))
+}
+
+fn status(directory: &File) -> io::Result<()> {
+    let bytes = bounded(&mut regular(directory, "status", libc::O_RDONLY, 11)?, 11)?;
+    if bytes != b"complete\n" {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+fn last_record(file: &mut File, enrollment: &Enrollment) -> io::Result<Option<Record>> {
+    let size = file.metadata()?.len();
+    if size == 0 {
+        return Ok(None);
+    }
+    if size > LIMIT {
+        return Err(invalid());
+    }
+    let start = size.saturating_sub(RECORD_LIMIT as u64 + 1);
+    file.seek(SeekFrom::Start(start))?;
+    let bytes = bounded(file, RECORD_LIMIT + 1)?;
+    if bytes.last() != Some(&b'\n') {
+        return Err(invalid());
+    }
+    let body = &bytes[..bytes.len() - 1];
+    let offset = body.iter().rposition(|b| *b == b'\n').map_or(0, |i| i + 1);
+    if start > 0 && offset == 0 || body.len() - offset + 1 > RECORD_LIMIT {
+        return Err(invalid());
+    }
+    let row: Record = serde_json::from_slice(&body[offset..]).map_err(|_| invalid())?;
+    if row.schema_version != 1
+        || row.sequence == 0
+        || row.session_id != enrollment.session_id
+        || row.boot_id != enrollment.boot_id
+        || row.pid == 0
+        || row.starttime_ticks == 0
+        || row.monotonic_ns == 0
+        || row.wall_time_ns == 0
+        || !matches!(row.event.as_str(), "begin" | "result")
+        || (row.event == "begin" && (row.outcome.is_some() || row.exit_code.is_some()))
+        || (row.event == "result"
+            && (!matches!(row.outcome.as_deref(), Some("ok" | "error")) || row.exit_code.is_none()))
+    {
+        return Err(invalid());
+    }
+    Ok(Some(row))
+}
+
+struct Active {
+    enrollment: Enrollment,
+    root_identity: Identity,
+    log_identity: Identity,
+    begin: Record,
+}
+
+pub(crate) struct Audit {
+    root: PathBuf,
+    active: Option<Active>,
+}
+
+impl Audit {
+    pub(crate) fn begin(opts: &Opts) -> Self {
+        Self::begin_at(PathBuf::from(ROOT), Selection::from_opts(opts))
+    }
+
+    fn begin_at(root: PathBuf, selected: Selection) -> Self {
+        let mut audit = Self { root, active: None };
+        match audit.start(selected) {
+            Ok(active) => audit.active = active,
+            Err(_) => audit.failed(),
+        }
+        audit
+    }
+
+    fn start(&self, selected: Selection) -> io::Result<Option<Active>> {
+        let Some(directory) = open_root(&self.root)? else {
+            return Ok(None);
+        };
+        let Some(enrollment) = enrollment(&directory)? else {
+            return Ok(None);
+        };
+        if let Some(cid) = &selected.container_id {
+            if cid.is_empty()
+                || cid.len() > 128
+                || cid == "."
+                || cid == ".."
+                || !cid
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"_+.-".contains(&b))
+            {
+                return Err(invalid());
+            }
+        }
+        status(&directory)?;
+        let mut log = regular(
+            &directory,
+            "events.jsonl",
+            libc::O_RDWR | libc::O_APPEND,
+            LIMIT,
+        )?;
+        lock(&log)?;
+        let mut begin = Record {
+            schema_version: 1,
+            sequence: 0,
+            event: "begin".to_owned(),
+            session_id: enrollment.session_id.clone(),
+            boot_id: enrollment.boot_id.clone(),
+            invocation_id: String::new(),
+            operation: selected.operation.to_owned(),
+            container_id: selected.container_id,
+            pid: std::process::id(),
+            starttime_ticks: birth()?,
+            monotonic_ns: clock(libc::CLOCK_MONOTONIC)?,
+            wall_time_ns: clock(libc::CLOCK_REALTIME)?,
+            outcome: None,
+            exit_code: None,
+        };
+        begin.invocation_id = format!(
+            "{}:{}:{}",
+            begin.pid, begin.starttime_ticks, begin.monotonic_ns
+        );
+        self.append(&directory, &mut log, &enrollment, &mut begin)?;
+        Ok(Some(Active {
+            enrollment,
+            root_identity: identity(&directory)?,
+            log_identity: identity(&log)?,
+            begin,
+        }))
+    }
+
+    fn append(
+        &self,
+        directory: &File,
+        log: &mut File,
+        enrolled: &Enrollment,
+        row: &mut Record,
+    ) -> io::Result<()> {
+        if enrollment(directory)?.as_ref() != Some(enrolled) {
+            return Err(invalid());
+        }
+        status(directory)?;
+        let reopened_root = open_root(&self.root)?.ok_or_else(invalid)?;
+        let reopened = regular(
+            &reopened_root,
+            "events.jsonl",
+            libc::O_RDWR | libc::O_APPEND,
+            LIMIT,
+        )?;
+        if identity(&reopened_root)? != identity(directory)?
+            || identity(&reopened)? != identity(log)?
+        {
+            return Err(invalid());
+        }
+        let last = last_record(log, enrolled)?;
+        row.sequence = last
+            .as_ref()
+            .map_or(Some(1), |r| r.sequence.checked_add(1))
+            .ok_or_else(invalid)?;
+        if last
+            .as_ref()
+            .is_some_and(|r| r.monotonic_ns > row.monotonic_ns)
+        {
+            return Err(invalid());
+        }
+        let mut bytes = serde_json::to_vec(row).map_err(|_| invalid())?;
+        bytes.push(b'\n');
+        if bytes.len() > RECORD_LIMIT
+            || log
+                .metadata()?
+                .len()
+                .checked_add(bytes.len() as u64)
+                .is_none_or(|n| n > LIMIT)
+        {
+            return Err(invalid());
+        }
+        log.write_all(&bytes)?;
+        log.sync_all()?;
+        Ok(())
+    }
+
+    pub(crate) fn finish(&mut self, ok: bool, exit_code: i32) {
+        let Some(active) = self.active.take() else {
+            return;
+        };
+        if self.finish_active(active, ok, exit_code).is_err() {
+            self.failed();
+        }
+    }
+
+    fn finish_active(&self, active: Active, ok: bool, exit_code: i32) -> io::Result<()> {
+        let directory = open_root(&self.root)?.ok_or_else(invalid)?;
+        if identity(&directory)? != active.root_identity
+            || enrollment(&directory)?.as_ref() != Some(&active.enrollment)
+        {
+            return Err(invalid());
+        }
+        let mut log = regular(
+            &directory,
+            "events.jsonl",
+            libc::O_RDWR | libc::O_APPEND,
+            LIMIT,
+        )?;
+        if identity(&log)? != active.log_identity {
+            return Err(invalid());
+        }
+        lock(&log)?;
+        if birth()? != active.begin.starttime_ticks || std::process::id() != active.begin.pid {
+            return Err(invalid());
+        }
+        let mut row = active.begin;
+        row.event = "result".to_owned();
+        row.monotonic_ns = clock(libc::CLOCK_MONOTONIC)?;
+        row.wall_time_ns = clock(libc::CLOCK_REALTIME)?;
+        row.outcome = Some(if ok { "ok" } else { "error" }.to_owned());
+        row.exit_code = Some((exit_code & 255) as u8);
+        self.append(&directory, &mut log, &active.enrollment, &mut row)
+    }
+
+    fn failed(&self) {
+        // Never replace an OCI result or prevent kill/delete because evidence
+        // failed. No error/source/path/args are included in this fixed warning.
+        let _ = (|| -> io::Result<()> {
+            let Some(directory) = open_root(&self.root)? else {
+                return Ok(());
+            };
+            let mut file = regular(&directory, "status", libc::O_RDWR, 11)?;
+            lock(&file)?;
+            let bytes = bounded(&mut file, 11)?;
+            if bytes != b"complete\n" && bytes != b"incomplete\n" {
+                return Err(invalid());
+            }
+            file.seek(SeekFrom::Start(0))?;
+            file.write_all(b"incomplete\n")?;
+            file.sync_all()
+        })();
+        // Unlike eprintln!, a broken diagnostic stream must not panic and
+        // override the OCI operation/result we are merely observing.
+        let _ = writeln!(io::stderr().lock(), "{WARNING}");
+    }
+}
