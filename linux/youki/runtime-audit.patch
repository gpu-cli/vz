+    #[test]
+    fn test_vz_runtime_audit_explicit_exit_and_error_routing() {
+        const CHILD: &str = "VZ_RUNTIME_AUDIT_NATIVE_CHILD";
+        const FAILURE: &str = "VZ_RUNTIME_AUDIT_NATIVE_FAILURE";
+        if let Some(path) = std::env::var_os(CHILD) {
+            // Only test builds accept a private fixture path; production has no
+            // environment-selected privileged audit sink.
+            let mut audit = Audit::begin_at(PathBuf::from(path), select());
+            assert_eq!(audit.active.is_none(), std::env::var_os(FAILURE).is_some());
+            crate::exit_with_audit(&mut audit, true, 37);
+        }
+        for failure in [false, true] {
+            let root = setup();
+            if failure {
+                File::options()
+                    .write(true)
+                    .open(root.path().join("events.jsonl"))
+                    .unwrap()
+                    .set_len(LIMIT + 1)
+                    .unwrap();
+            }
+            let mut command = Command::new(std::env::current_exe().unwrap());
+            command
+                .args([
+                    "--exact",
+                    "runtime_audit::tests::test_vz_runtime_audit_explicit_exit_and_error_routing",
+                    "--nocapture",
+                ])
+                .env(CHILD, root.path())
+                .env_remove(FAILURE)
+                .stdin(Stdio::null())
+                .stdout(Stdio::null());
+            if failure {
+                command.env(FAILURE, "1").stderr(Stdio::from(
+                    File::options().write(true).open("/dev/full").unwrap(),
+                ));
+            }
+            let mut child = command.spawn().unwrap();
+            let deadline = Instant::now() + Duration::from_secs(10);
+            let status = loop {
+                if let Some(status) = child.try_wait().unwrap() {
+                    break status;
+                }
+                if Instant::now() >= deadline {
+                    // Direct child was not reaped by try_wait; kill/reap only
+                    // that retained Child, never a guessed/reused process ID.
+                    child.kill().unwrap();
+                    child.wait().unwrap();
+                    panic!("native audit child deadline exceeded");
+                }
+                thread::sleep(Duration::from_millis(10));
+            };
+            assert_eq!(status.code(), Some(37));
+            if failure {
+                assert_eq!(
+                    fs::read(root.path().join("status")).unwrap(),
+                    b"incomplete\n"
+                );
+            } else {
+                assert_eq!(rows(root.path()).len(), 2);
+                assert_eq!(rows(root.path())[1].exit_code, Some(37));
+            }
+        }
+        let root = setup();
+        let mut audit = Audit::begin_at(root.path().to_owned(), select());
+        let error =
+            crate::return_with_audit(&mut audit, Err(anyhow::anyhow!("private error detail")))
+                .unwrap_err();
+        assert_eq!(error.to_string(), "private error detail");
+        assert_eq!(rows(root.path())[1].exit_code, Some(1));
+        assert!(
+            !fs::read_to_string(root.path().join("events.jsonl"))
+                .unwrap()
+                .contains("private error detail")
+        );
+        let source = include_str!("main.rs");
+        assert_eq!(source.matches("exit_with_audit(&mut audit,").count(), 4);
+        assert!(source.contains("return_with_audit(&mut audit, cmd_result)"));
+    }
