+    #[test]
+    fn test_vz_runtime_audit_concurrent_pairs_and_sequences() {
+        let root = setup();
+        let barrier = Arc::new(Barrier::new(8));
+        let threads: Vec<_> = (0..8)
+            .map(|_| {
+                let path = root.path().to_owned();
+                let barrier = barrier.clone();
+                thread::spawn(move || {
+                    barrier.wait();
+                    let mut audit = Audit::begin_at(path, select());
+                    assert!(audit.active.is_some());
+                    audit.finish(true, 0);
+                })
+            })
+            .collect();
+        for t in threads {
+            t.join().unwrap();
+        }
+        let records = rows(root.path());
+        assert_eq!(records.len(), 16);
+        for (index, row) in records.iter().enumerate() {
+            assert_eq!(row.sequence, index as u64 + 1);
+        }
+        assert!(
+            records
+                .windows(2)
+                .all(|r| r[0].monotonic_ns <= r[1].monotonic_ns)
+        );
+        for begin in records.iter().filter(|r| r.event == "begin") {
+            assert_eq!(
+                records
+                    .iter()
+                    .filter(|r| r.invocation_id == begin.invocation_id)
+                    .count(),
+                2
+            );
+        }
+        unchanged_status(root.path());
+    }
