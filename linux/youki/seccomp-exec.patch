 type Result<T> = std::result::Result<T, ProcessError>;
 
+#[cfg(feature = "libseccomp")]
+fn seccomp_notification_state(
+    seccomp: Option<&oci_spec::runtime::LinuxSeccomp>,
+    original: Option<&crate::container::State>,
+    kind: ContainerType,
+    payload_pid: Pid,
+) -> Result<Option<oci_spec::runtime::ContainerProcessState>> {
+    let Some(seccomp) = seccomp.filter(|profile| crate::seccomp::is_notify(profile)) else {
+        // Ordinary filters need no listener and no lifecycle Container. In
+        // particular, tenant exec deliberately owns no mutable init state.
+        return Ok(None);
+    };
+    let original = original.ok_or(ProcessError::ContainerStateRequired)?;
+    let status = match kind {
+        ContainerType::InitContainer => oci_spec::runtime::ContainerState::Creating,
+        ContainerType::TenantContainer { .. } => oci_spec::runtime::ContainerState::Running,
+    };
+    let state = oci_spec::runtime::StateBuilder::default()
+        .version(OCI_VERSION)
+        .id(original.id.clone())
+        .status(status)
+        .pid(payload_pid.as_raw())
+        .bundle(original.bundle.clone())
+        .annotations(original.annotations.clone().unwrap_or_default())
+        .build()
+        .map_err(|error| ProcessError::OciStateBuild(error.to_string()))?;
+    Ok(Some(
+        oci_spec::runtime::ContainerProcessStateBuilder::default()
+            .version(OCI_VERSION)
+            .fds(vec![SECCOMP_FD_NAME.to_string()])
+            .pid(payload_pid.as_raw())
+            .metadata(seccomp.listener_metadata().clone().unwrap_or_default())
+            .state(state)
+            .build()
+            .map_err(|error| ProcessError::OciStateBuild(error.to_string()))?,
+    ))
+}
