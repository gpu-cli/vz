+    #[test]
+    fn test_vz_seccomp_notify_uses_immutable_original_and_payload_pid() {
+        let profile = serde_json::from_str(
+            r#"{"defaultAction":"SCMP_ACT_ALLOW","listenerPath":"/listener","listenerMetadata":"exact-metadata","syscalls":[{"names":["uname"],"action":"SCMP_ACT_NOTIFY"}]}"#,
+        ).unwrap();
+        let mut original = crate::container::Container::default().state;
+        original.id = "exact-original-container".into();
+        original.bundle = PathBuf::from("/declared/bundle");
+        original.pid = Some(777);
+        original.annotations = Some(std::collections::HashMap::from([(
+            "proof".into(),
+            "original".into(),
+        )]));
+        let before = serde_json::to_value(&original).unwrap();
+        for (kind, status) in [
+            (ContainerType::InitContainer, "creating"),
+            (
+                ContainerType::TenantContainer { exec_notify_fd: -1 },
+                "running",
+            ),
+        ] {
+            assert!(matches!(
+                seccomp_notification_state(Some(&profile), None, kind, Pid::from_raw(42)),
+                Err(ProcessError::ContainerStateRequired)
+            ));
+            let value = seccomp_notification_state(
+                Some(&profile),
+                Some(&original),
+                kind,
+                Pid::from_raw(42),
+            )
+            .unwrap()
+            .unwrap();
+            let value = serde_json::to_value(value).unwrap();
+            assert_eq!(value["pid"], 42);
+            assert_eq!(value["state"]["pid"], 42);
+            assert_eq!(value["state"]["status"], status);
+            assert_eq!(value["state"]["id"], "exact-original-container");
+            assert_eq!(value["state"]["bundle"], "/declared/bundle");
+            assert_eq!(value["state"]["annotations"]["proof"], "original");
+            assert_eq!(value["metadata"], "exact-metadata");
+            assert_eq!(value["fds"], serde_json::json!([SECCOMP_FD_NAME]));
+            assert_eq!(serde_json::to_value(&original).unwrap(), before);
+        }
+    }
+}
