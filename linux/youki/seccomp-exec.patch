+    fn assert_vz_tenant_seccomp_profile(profile: Option<oci_spec::runtime::LinuxSeccomp>) {
+        for from_process_file in [false, true] {
+            for no_new_privileges in [None, Some(false), Some(true)] {
+                let temporary = tempfile::tempdir().unwrap();
+                let mut spec = Spec::default();
+                let mut linux = spec.linux().clone().unwrap();
+                linux.set_seccomp(profile.clone());
+                spec.set_linux(Some(linux));
+                let mut process = spec.process().clone().unwrap();
+                process.set_no_new_privileges(no_new_privileges);
+                spec.set_process(Some(process));
+                let mut container = Container::default();
+                container.set_pid(nix::unistd::getpid().as_raw());
+                let mut builder =
+                    builder_with_env(&[]).with_container_args(vec!["/bin/true".into()]);
+                if from_process_file {
+                    let path = temporary.path().join("process.json");
+                    fs::write(
+                        &path,
+                        serde_json::to_vec(spec.process().as_ref().unwrap()).unwrap(),
+                    )
+                    .unwrap();
+                    builder = builder.with_process(Some(path));
+                }
+                builder
+                    .adapt_spec_for_tenant(&mut spec, &container)
+                    .unwrap();
+                assert_eq!(spec.linux().as_ref().unwrap().seccomp(), &profile);
+                assert_eq!(
+                    spec.process().as_ref().unwrap().no_new_privileges(),
+                    if from_process_file {
+                        no_new_privileges
+                    } else {
+                        no_new_privileges.or(Some(true))
+                    }
+                );
+            }
+        }
+    }
