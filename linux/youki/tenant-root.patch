+    if matches!(args.container_type, ContainerType::TenantContainer { .. }) {
+        // Mount setns restores the namespace root, which can be wider than
+        // init's chroot (notably under an initramfs). Re-enter its pinned root
+        // without remounting or mutating the shared namespace. Taking ownership
+        // closes all child handles on success/error; the forked parent retains
+        // its separate fd table and its own unchanged ownership state.
+        let root = args
+            .tenant_root
+            .as_ref()
+            .and_then(|root| root.borrow_mut().take())
+            .ok_or_else(|| {
+                InitProcessError::Io(std::io::Error::other("missing pinned tenant root"))
+            })?;
+        root.enter().map_err(InitProcessError::Io)?;
+    }
