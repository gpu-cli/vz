+//! Locally authored vz exec-root fix. Acquisition pins a single proc directory;
+//! this prevents PID reuse from mixing roots/namespaces during admission. The
+//! upstream persisted state has no process birth identity: this does not claim
+//! to authenticate a stale PID before acquisition.
+use std::ffi::{CStr, CString};
+use std::io;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::path::PathBuf;
+
+use nix::unistd::Pid;
+use oci_spec::runtime::{LinuxNamespaceType, Spec};
+
+pub(crate) struct TenantRoot {
+    proc: OwnedFd,
+    root: OwnedFd,
+    namespaces: Vec<OwnedFd>,
+}
+
+fn owned(result: libc::c_int) -> io::Result<OwnedFd> {
+    if result < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful openat/fcntl returns a new exclusively owned fd.
+    Ok(unsafe { OwnedFd::from_raw_fd(result) })
+}
+
+fn open_at(dir: RawFd, name: &CStr, flags: i32, floor: i32) -> io::Result<OwnedFd> {
+    // SAFETY: name is NUL terminated; no O_CREAT, so no mode argument is needed.
+    let fd = owned(unsafe { libc::openat(dir, name.as_ptr(), flags | libc::O_CLOEXEC) })?;
+    // Always duplicate above stdio and caller-preserved descriptors. CLOEXEC is
+    // reapplied atomically, even if an open initially filled a closed stdio slot.
+    owned(unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_DUPFD_CLOEXEC, floor) })
+}
+
+impl TenantRoot {
+    pub(crate) fn capture(pid: Pid, spec: &mut Spec, preserve_fds: i32) -> io::Result<Self> {
+        let floor = preserve_fds
+            .checked_add(3)
+            .filter(|n| *n >= 3)
+            .ok_or_else(|| io::Error::other("invalid preserved fd count"))?;
+        if pid.as_raw() <= 0 {
+            return Err(io::Error::other("invalid init pid"));
+        }
+        let path = CString::new(format!("/proc/{}", pid.as_raw())).unwrap();
+        let proc = open_at(
+            libc::AT_FDCWD,
+            &path,
+            libc::O_PATH | libc::O_DIRECTORY,
+            floor,
+        )?;
+        let root = open_at(
+            proc.as_raw_fd(),
+            c"root",
+            libc::O_PATH | libc::O_DIRECTORY,
+            floor,
+        )?;
+        let mut linux = spec
+            .linux()
+            .clone()
+            .ok_or_else(|| io::Error::other("missing linux spec"))?;
+        let mut namespaces = linux
+            .namespaces()
+            .clone()
+            .ok_or_else(|| io::Error::other("missing namespaces"))?;
+        let mut handles = Vec::with_capacity(namespaces.len());
+        for namespace in &mut namespaces {
+            let name = match namespace.typ() {
+                LinuxNamespaceType::Mount => c"ns/mnt",
+                LinuxNamespaceType::Pid => c"ns/pid",
+                LinuxNamespaceType::Network => c"ns/net",
+                LinuxNamespaceType::User => c"ns/user",
+                LinuxNamespaceType::Ipc => c"ns/ipc",
+                LinuxNamespaceType::Uts => c"ns/uts",
+                LinuxNamespaceType::Cgroup => c"ns/cgroup",
+                LinuxNamespaceType::Time => c"ns/time",
+            };
+            let fd = open_at(proc.as_raw_fd(), name, libc::O_RDONLY, floor)?;
+            namespace.set_path(Some(PathBuf::from(format!(
+                "/proc/self/fd/{}",
+                fd.as_raw_fd()
+            ))));
+            handles.push(fd);
+        }
+        linux.set_namespaces(Some(namespaces));
+        spec.set_linux(Some(linux));
+        let pinned = Self {
+            proc,
+            root,
+            namespaces: handles,
+        };
+        pinned.check_live_root()?;
+        Ok(pinned)
+    }
+
+    fn check_live_root(&self) -> io::Result<()> {
+        // Relative lookup through the held proc directory cannot resolve a
+        // reused numeric PID. A dead task has no root; a changed root is refused.
+        let current = open_at(
+            self.proc.as_raw_fd(),
+            c"root",
+            libc::O_PATH | libc::O_DIRECTORY,
+            3,
+        )?;
+        let identity = |fd| -> io::Result<(libc::dev_t, libc::ino_t)> {
+            let mut value = std::mem::MaybeUninit::<libc::stat>::uninit();
+            // SAFETY: fstat initializes value on success, and fd is borrowed.
+            if unsafe { libc::fstat(fd, value.as_mut_ptr()) } != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            let value = unsafe { value.assume_init() };
+            Ok((value.st_dev, value.st_ino))
+        };
+        if identity(current.as_raw_fd())? != identity(self.root.as_raw_fd())? {
+            return Err(io::Error::other(
+                "container init root changed during exec admission",
+            ));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn enter(self) -> io::Result<()> {
+        self.check_live_root()?;
+        self.enter_with(|step, fd| {
+            // SAFETY: the owned root fd remains live for this entire operation;
+            // C string literals are valid and no pointer outlives this call.
+            let rc = unsafe {
+                match step {
+                    0 => libc::fchdir(fd),
+                    1 => libc::chroot(c".".as_ptr()),
+                    _ => libc::chdir(c"/".as_ptr()),
+                }
+            };
+            if rc < 0 {
+                Err(io::Error::last_os_error())
+            } else {
+                Ok(())
+            }
+        })
+    }
+
+    fn enter_with(self, mut call: impl FnMut(u8, RawFd) -> io::Result<()>) -> io::Result<()> {
+        // All namespaces have been joined. Close those references before root
+        // entry; root stays exclusively owned and is dropped on every path.
+        drop(self.namespaces);
+        drop(self.proc);
+        for step in 0..3 {
+            call(step, self.root.as_raw_fd())?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::MetadataExt;
+
+    #[test]
+    fn test_vz_tenant_root_pins_namespace_identity_and_cloexec() {
+        let mut spec = Spec::default();
+        let pinned = TenantRoot::capture(Pid::this(), &mut spec, 12).unwrap();
+        for fd in std::iter::once(&pinned.root).chain(&pinned.namespaces) {
+            assert!(fd.as_raw_fd() >= 15);
+            assert_ne!(
+                unsafe { libc::fcntl(fd.as_raw_fd(), libc::F_GETFD) } & libc::FD_CLOEXEC,
+                0
+            );
+        }
+        let root = std::fs::metadata(format!("/proc/self/fd/{}", pinned.root.as_raw_fd())).unwrap();
+        let current = std::fs::metadata("/").unwrap();
+        assert_eq!((root.dev(), root.ino()), (current.dev(), current.ino()));
+        for ns in spec
+            .linux()
+            .as_ref()
+            .unwrap()
+            .namespaces()
+            .as_ref()
+            .unwrap()
+        {
+            assert!(ns.path().as_ref().unwrap().starts_with("/proc/self/fd"));
+            assert!(std::fs::metadata(ns.path().as_ref().unwrap()).is_ok());
+        }
+    }
+
+    #[test]
+    fn test_vz_tenant_root_failure_stops_and_closes_handles() {
+        for failure in 0..4 {
+            let pinned = TenantRoot::capture(Pid::this(), &mut Spec::default(), 0).unwrap();
+            let root_fd = pinned.root.as_raw_fd();
+            let namespace_fds: Vec<_> = pinned.namespaces.iter().map(AsRawFd::as_raw_fd).collect();
+            let mut calls = Vec::new();
+            let result = pinned.enter_with(|step, fd| {
+                assert_eq!(fd, root_fd);
+                assert!(
+                    namespace_fds
+                        .iter()
+                        .all(|fd| unsafe { libc::fcntl(*fd, libc::F_GETFD) } == -1)
+                );
+                calls.push(step);
+                if step == failure {
+                    Err(io::Error::other("injected root-entry failure"))
+                } else {
+                    Ok(())
+                }
+            });
+            assert_eq!(result.is_ok(), failure == 3);
+            assert_eq!(calls, (0..=failure.min(2)).collect::<Vec<_>>());
+            assert_eq!(unsafe { libc::fcntl(root_fd, libc::F_GETFD) }, -1);
+        }
+    }
+
+    #[test]
+    fn test_vz_tenant_root_rejects_missing_process_and_invalid_fd_floor() {
+        assert!(TenantRoot::capture(Pid::from_raw(i32::MAX), &mut Spec::default(), 0).is_err());
+        assert!(TenantRoot::capture(Pid::this(), &mut Spec::default(), -1).is_err());
+        assert!(TenantRoot::capture(Pid::this(), &mut Spec::default(), i32::MAX).is_err());
+    }
+
+    #[test]
+    fn test_vz_tenant_root_refuses_exited_pinned_init() {
+        let mut child = std::process::Command::new("sleep")
+            .arg("60")
+            .spawn()
+            .unwrap();
+        let capture =
+            TenantRoot::capture(Pid::from_raw(child.id() as i32), &mut Spec::default(), 0);
+        child.kill().unwrap();
+        child.wait().unwrap();
+        let pinned = capture.unwrap();
+        assert!(pinned.check_live_root().is_err());
+        assert!(pinned.enter().is_err());
+    }
+}
