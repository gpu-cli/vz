+/// The runc-compatible JSON contract read by containerd's getLastRuntimeError.
+/// Keep event fields nested: fields named level/msg/time must never replace
+/// authoritative metadata or introduce duplicate JSON keys. Delegate collection
+/// and escaping (including typed fields and current-span context) to tracing.
+struct RuntimeJson;
+
+impl<S, N> FormatEvent<S, N> for RuntimeJson
+where
+    S: Subscriber + for<'lookup> LookupSpan<'lookup>,
+    N: for<'writer> FormatFields<'writer> + 'static,
+{
+    fn format_event(
+        &self,
+        ctx: &FmtContext<'_, S, N>,
+        mut writer: Writer<'_>,
+        event: &Event<'_>,
+    ) -> std::fmt::Result {
+        let mut original = String::new();
+        tracing_subscriber::fmt::format()
+            .json()
+            .flatten_event(false)
+            .with_span_list(false)
+            .format_event(ctx, Writer::new(&mut original), event)?;
+        let mut record: serde_json::Map<String, serde_json::Value> =
+            serde_json::from_str(&original).map_err(|_| std::fmt::Error)?;
+        let time = record.remove("timestamp").ok_or(std::fmt::Error)?;
+        let fields = record.get("fields").ok_or(std::fmt::Error)?;
+        let message = match fields.get("message").and_then(serde_json::Value::as_str) {
+            Some(message) => message.to_owned(),
+            // Structured-only errors still need a diagnostic for containerd.
+            None => serde_json::to_string(fields).map_err(|_| std::fmt::Error)?,
+        };
+        record.insert("time".to_owned(), time);
+        record.insert(
+            "level".to_owned(),
+            event
+                .metadata()
+                .level()
+                .as_str()
+                .to_ascii_lowercase()
+                .into(),
+        );
+        record.insert("msg".to_owned(), message.into());
+        let mut encoded = serde_json::to_string(&record).map_err(|_| std::fmt::Error)?;
+        encoded.push('\n');
+        writer.write_str(&encoded)
+    }
+}
+
