     use libcontainer::test_utils::TestCallbackError;
 
     use super::*;
+
+    fn runtime_log_records(path: &Path) -> Vec<serde_json::Value> {
+        let raw = std::fs::read_to_string(path).expect("read actual runtime log");
+        assert!(raw.ends_with('\n'), "complete newline-terminated records");
+        raw.lines()
+            .map(|line| {
+                let value: serde_json::Value = serde_json::from_str(line).expect("JSON log record");
+                chrono::DateTime::parse_from_rfc3339(value["time"].as_str().expect("string time"))
+                    .expect("containerd-compatible RFC3339 time");
+                assert!(value["msg"].is_string());
+                value
+            })
+            .collect()
+    }
+
+    #[test]
+    fn test_vz_runtime_log_formatter_preserves_fields_and_escaping() {
+        let directory = tempfile::tempdir().expect("test directory");
+        let path = directory.path().join("runtime.json");
+        let file = std::fs::File::create(&path).expect("create test log");
+        let subscriber = tracing_subscriber::registry().with(
+            tracing_subscriber::fmt::layer()
+                .json()
+                .event_format(RuntimeJson)
+                .with_writer(file),
+        );
+        let message = "quoted \"error\"\\path\nsecond line\t雪\0";
+        tracing::subscriber::with_default(subscriber, || {
+            let span = tracing::info_span!("owned_span", machine = "fixture");
+            let _entered = span.enter();
+            tracing::trace!("trace record");
+            tracing::debug!("debug record");
+            tracing::info!("info record");
+            tracing::warn!("warn record");
+            tracing::error!(
+                level = "info",
+                msg = "not the diagnostic",
+                time = "not a timestamp",
+                attempts = 7_u64,
+                negative = -3_i64,
+                fraction = 1.5_f64,
+                active = true,
+                detail = ?vec!["one", "two"],
+                "{message}"
+            );
+            tracing::error!(errno = 2_i64);
+        });
+        let records = runtime_log_records(&path);
+        assert_eq!(records.len(), 6);
+        let levels: Vec<_> = records
+            .iter()
+            .map(|row| row["level"].as_str().unwrap())
+            .collect();
+        assert_eq!(levels, ["trace", "debug", "info", "warn", "error", "error"]);
+        let row = &records[4];
+        assert_eq!(row["msg"], message);
+        assert_eq!(row["fields"]["message"], message);
+        assert_eq!(row["fields"]["level"], "info");
+        assert_eq!(row["fields"]["msg"], "not the diagnostic");
+        assert_eq!(row["fields"]["time"], "not a timestamp");
+        assert_eq!(row["fields"]["attempts"], 7);
+        assert_eq!(row["fields"]["negative"], -3);
+        assert_eq!(row["fields"]["fraction"], 1.5);
+        assert_eq!(row["fields"]["active"], true);
+        assert_eq!(row["fields"]["detail"], "[\"one\", \"two\"]");
+        assert_eq!(row["span"]["name"], "owned_span");
+        assert_eq!(row["span"]["machine"], "fixture");
+        assert!(
+            row["target"]
+                .as_str()
+                .unwrap()
+                .ends_with("observability::tests")
+        );
+        assert_eq!(records[5]["msg"], "{\"errno\":2}");
+    }
 
