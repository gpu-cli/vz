+fn console_winsize(
+    console_size: Option<&oci_spec::runtime::Box>,
+) -> Result<Option<nix::pty::Winsize>> {
+    console_size
+        .map(|size| {
+            let height = u64::from(size.height());
+            let width = u64::from(size.width());
+            let ws_row = u16::try_from(height)
+                .map_err(|_| TTYError::InvalidConsoleSize { height, width })?;
+            let ws_col =
+                u16::try_from(width).map_err(|_| TTYError::InvalidConsoleSize { height, width })?;
+            Ok(nix::pty::Winsize {
+                ws_row,
+                ws_col,
+                ws_xpixel: 0,
+                ws_ypixel: 0,
+            })
+        })
+        .transpose()
+}
