+    // replaced with invented defaults. Overflow fails before allocating a PTY.
+    let size = console_winsize(console_size)?;
+    nix::pty::openpty(size.as_ref(), None)
+        .map_err(|source| TTYError::CreatePseudoTerminal { source })
