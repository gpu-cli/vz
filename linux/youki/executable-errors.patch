+    // Diagnostic compatibility only. These deliberately small mirrors of the
+    // pinned consumers do not execute Go, Docker, a container or a payload:
+    // docker/cli v29.4.0 cli/command/container/run.go:306-329 (case-sensitive)
+    // moby/moby v29.7.2 daemon/errors.go:126-185 (case-insensitive).
+    fn vz_cli_start_status(message: &str) -> i32 {
+        if [
+            "executable file not found",
+            "no such file or directory",
+            "system cannot find the file specified",
+        ]
+        .iter()
+        .any(|needle| message.contains(*needle))
+        {
+            127
+        } else if message.contains("permission denied") || message.contains("is a directory") {
+            126
+        } else {
+            125
+        }
+    }
+
+    fn vz_moby_start_status(message: &str) -> i32 {
+        let message = message.to_lowercase();
+        if message.contains("permission denied") || message.contains("is a directory") {
+            126
+        } else if [
+            "not a directory",
+            "executable file not found",
+            "no such file or directory",
+            "system cannot find the file specified",
+            "failed to run runc create/exec call",
+        ]
+        .iter()
+        .any(|needle| message.contains(*needle))
+        {
+            127
+        } else {
+            128
+        }
+    }
+
+    fn vz_validation_message(command: String, search_path: &Path) -> String {
+        let spec = executable_permission_spec(command, search_path);
+        let error = DefaultExecutor {}.validate(&spec).unwrap_err();
+        match &error {
+            ExecutorValidationError::ArgValidationError(message) => {
+                assert_eq!(error.to_string(), *message);
+            }
+            _ => panic!("unexpected executor error variant"),
+        }
+        error.to_string()
+    }
