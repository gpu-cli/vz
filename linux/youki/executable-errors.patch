+    #[test]
+    fn test_vz_executable_errors_missing_paths() {
+        let directory = tempfile::tempdir().unwrap();
+        let absolute = directory.path().join("missing-command");
+        for command in [
+            absolute.to_string_lossy().into_owned(),
+            "missing-command".to_owned(),
+        ] {
+            let message = vz_validation_message(command.clone(), directory.path());
+            assert_eq!(
+                message,
+                format!(
+                    "executable file not found: executable '{}' not found in $PATH",
+                    command
+                )
+            );
+            assert_eq!(vz_cli_start_status(&message), 127);
+            assert_eq!(vz_moby_start_status(&message), 127);
+        }
+        assert!(!absolute.exists());
+        assert_eq!(std::fs::read_dir(directory.path()).unwrap().count(), 0);
+    }
