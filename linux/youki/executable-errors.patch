+    #[test]
+    fn test_vz_executable_errors_classifier_controls_and_context() {
+        for (message, cli, moby) in [
+            ("generic runtime failure", 125, 128),
+            (
+                "executable 'old' does not have correct permissions",
+                125,
+                128,
+            ),
+            ("executable 'old' not found in $PATH", 125, 128),
+            ("Permission denied", 125, 126),
+            ("Executable file not found", 125, 127),
+            ("permission denied", 126, 126),
+            ("is a directory", 126, 126),
+            ("executable file not found", 127, 127),
+        ] {
+            assert_eq!(vz_cli_start_status(message), cli, "CLI: {message}");
+            assert_eq!(vz_moby_start_status(message), moby, "Moby: {message}");
+        }
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("retained-context");
+        std::fs::write(&path, b"validation-only fixture").unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600)).unwrap();
+        let original = vz_validation_message(path.to_string_lossy().into_owned(), directory.path());
+        assert!(original.contains(&format!(
+            "executable '{}' at path '{:?}'",
+            path.display(),
+            path
+        )));
+        let wrapped = format!("OCI runtime create failed: error in executing command: {original}");
+        assert_eq!(vz_cli_start_status(&wrapped), 126);
+        assert_eq!(vz_moby_start_status(&wrapped), 126);
+        let mut spec = Spec::default();
+        spec.set_process(None);
+        let unrelated = DefaultExecutor {}.validate(&spec).unwrap_err().to_string();
+        assert_eq!(unrelated, "spec did not contain process");
+        assert_eq!(vz_cli_start_status(&unrelated), 125);
+        assert_eq!(vz_moby_start_status(&unrelated), 128);
+    }
