     #[test]
+    fn test_vz_executable_errors_denied_permissions() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("non-executable");
+        std::fs::write(&path, b"validation-only fixture").unwrap();
+        for mode in [0o600, 0o000] {
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(mode)).unwrap();
+            let message =
+                vz_validation_message(path.to_string_lossy().into_owned(), directory.path());
+            assert_eq!(
+                message,
+                format!(
+                    "permission denied: executable '{}' at path '{:?}' does not have correct permissions",
+                    path.display(),
+                    path
+                )
+            );
+            assert_eq!(vz_cli_start_status(&message), 126);
+            assert_eq!(vz_moby_start_status(&message), 126);
+            assert_eq!(path.metadata().unwrap().permissions().mode() & 0o777, mode);
+        }
+        let path = directory.path().join("executable-directory");
+        std::fs::create_dir(&path).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o755)).unwrap();
+        let message = vz_validation_message(path.to_string_lossy().into_owned(), directory.path());
+        assert!(message.starts_with("permission denied: "));
+        assert_eq!(vz_cli_start_status(&message), 126);
+        assert_eq!(vz_moby_start_status(&message), 126);
+        assert!(path.is_dir());
+        assert_eq!(path.metadata().unwrap().permissions().mode() & 0o777, 0o755);
+    }
