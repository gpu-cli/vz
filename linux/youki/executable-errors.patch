+    #[test]
+    fn test_vz_executable_errors_allowed_modes_unchanged() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("allowed-command");
+        std::fs::write(&path, b"validation-only fixture").unwrap();
+        for mode in [0o700, 0o710, 0o010, 0o001, 0o755] {
+            std::fs::set_permissions(&path, std::fs::Permissions::from_mode(mode)).unwrap();
+            for command in [
+                path.to_string_lossy().into_owned(),
+                "allowed-command".to_owned(),
+            ] {
+                let spec = executable_permission_spec(command, directory.path());
+                assert!(DefaultExecutor {}.validate(&spec).is_ok());
+            }
+            assert_eq!(path.metadata().unwrap().permissions().mode() & 0o777, mode);
+        }
+        assert_eq!(std::fs::read(&path).unwrap(), b"validation-only fixture");
+        // Validation still delegates real credentials, ACLs, noexec mounts,
+        // interpreter resolution and executable format to unchanged execvp.
+    }
