+    /// Bind a listener on a name no concurrent invocation can also hold.
+    ///
+    /// Reservation is the bind itself. Choosing a name, testing that no file
+    /// holds it and binding it later is a check-then-use race: both invocations
+    /// see the name free and the loser's bind fails with `EADDRINUSE`, which is
+    /// what surfaced as `failed to bind notify socket` when a container's
+    /// healthcheck and an exec entered the same container together.
+    pub(crate) fn bind_unique(directory: &Path, prefix: &str) -> Result<(Self, ReservedSocketPath)> {
+        for attempt in 0..UNIQUE_NAME_ATTEMPTS {
+            let path = directory.join(unique_socket_name(prefix, attempt));
+            match Self::new(&path) {
+                Ok(listener) => return Ok((listener, ReservedSocketPath::new(path))),
+                Err(NotifyListenerError::Bind { source, .. })
+                    if source.kind() == std::io::ErrorKind::AddrInUse =>
+                {
+                    tracing::debug!(?path, "notify socket name already held; retrying");
+                }
+                Err(err) => return Err(err),
+            }
+        }
+
+        Err(NotifyListenerError::NoUniqueName {
+            directory: directory.to_owned(),
+            attempts: UNIQUE_NAME_ATTEMPTS,
+        })
+    }
