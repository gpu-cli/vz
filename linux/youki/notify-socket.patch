+
+    /// The defect this module was corrected for, stated as a property.
+    ///
+    /// A name that is only a `fastrand` draw repeats whenever two invocations
+    /// seed identically, and `fastrand` seeds from a hash of the monotonic
+    /// clock, so invocations started together routinely do. This is the
+    /// generator that produced `tenant-notify-<hex>.sock`.
+    #[test]
+    fn test_vz_notify_socket_draw_only_name_repeats_under_equal_seeds() {
+        fastrand::seed(0x5eed);
+        let first = format!("tenant-notify-{:x}.sock", fastrand::i32(..));
+        fastrand::seed(0x5eed);
+        let second = format!("tenant-notify-{:x}.sock", fastrand::i32(..));
+        assert_eq!(
+            first, second,
+            "equally seeded draws must be shown to repeat, or this test proves nothing"
+        );
+    }
+
+    /// The correction: identical draws no longer mean identical names, because
+    /// the process id two live invocations cannot share is part of the name.
+    #[test]
+    fn test_vz_notify_socket_name_separates_equally_seeded_invocations() {
+        for seed in [0u64, 1, 0x5eed, u64::MAX] {
+            fastrand::seed(seed);
+            let first = socket_name("tenant-notify-", 4321, 0);
+            fastrand::seed(seed);
+            let second = socket_name("tenant-notify-", 4322, 0);
+            assert_ne!(
+                first, second,
+                "two invocations seeded alike must not pick the same name"
+            );
+        }
+    }
+
+    /// One invocation's attempts are distinct from each other, so a retry
+    /// cannot re-offer the name that was just refused.
+    #[test]
+    fn test_vz_notify_socket_name_separates_attempts() {
+        fastrand::seed(11);
+        let first = socket_name("tenant-notify-", 4321, 0);
+        fastrand::seed(11);
+        let second = socket_name("tenant-notify-", 4321, 1);
+        assert_ne!(first, second, "attempts of one invocation must differ");
+    }
+
+    /// The reservation is the bind, not a test for the name's absence.
+    ///
+    /// Both calls run in one process with one seed, so both compute the same
+    /// first candidate - the worst case the old check-then-bind failed on.
+    /// The second must still come away with a bound listener of its own.
+    #[test]
+    fn test_vz_notify_socket_bind_unique_reserves_under_identical_candidates() {
+        let dir = tempdir().unwrap();
+        fastrand::seed(3);
+        let (first, first_path) = NotifyListener::bind_unique(dir.path(), "tenant-notify-").unwrap();
+        fastrand::seed(3);
+        let (second, second_path) =
+            NotifyListener::bind_unique(dir.path(), "tenant-notify-").unwrap();
+
+        assert_ne!(
+            first_path.path(),
+            second_path.path(),
+            "a concurrent invocation must not be handed the same socket"
+        );
+        assert!(first_path.path().exists() && second_path.path().exists());
+        // Both listeners are live and independently addressable.
+        NotifySocket::new(first_path.path().to_owned())
+            .notify_container_start()
+            .unwrap();
+        first.wait_for_container_start().unwrap();
+        NotifySocket::new(second_path.path().to_owned())
+            .notify_container_start()
+            .unwrap();
+        second.wait_for_container_start().unwrap();
+
+        // The reservation is released with the invocation that held it, so a
+        // container directory does not accumulate one socket per exec.
+        let held = (first_path.path().to_owned(), second_path.path().to_owned());
+        drop(first_path);
+        drop(second_path);
+        assert!(!held.0.exists() && !held.1.exists(), "sockets outlived their invocations");
+    }
+
+    /// A bind failure must not leave the process parked in the container
+    /// directory: the caller's next relative path would resolve there.
+    #[test]
+    fn test_vz_notify_socket_failed_bind_restores_working_directory() {
+        let dir = tempdir().unwrap();
+        let taken = dir.path().join("taken.sock");
+        let _held = NotifyListener::new(&taken).unwrap();
+        let before = env::current_dir().unwrap();
+
+        let error = match NotifyListener::new(&taken) {
+            Ok(_) => panic!("a name already bound must not be handed out twice"),
+            Err(error) => error,
+        };
+        assert!(
+            matches!(&error, NotifyListenerError::Bind { source, .. }
+                if source.kind() == std::io::ErrorKind::AddrInUse),
+            "unexpected error: {error}"
+        );
+        assert_eq!(
+            env::current_dir().unwrap(),
+            before,
+            "the working directory must survive a failed bind"
+        );
+    }
 }
