 type Result<T> = std::result::Result<T, NotifyListenerError>;
 
+/// Build the name of a per-invocation socket in a container directory.
+///
+/// The identity of the invocation, not a random draw, is what keeps the name
+/// apart from a concurrent one. `fastrand`'s global generator seeds itself from
+/// a hash of `Instant::now()` and the thread id, so two runtime processes that
+/// start in the same instant seed identically and draw identical values; a name
+/// built from the draw alone then repeats between them. The process id cannot
+/// repeat between two live invocations, so it carries the uniqueness, the
+/// attempt counter separates the names one invocation tries in turn, and the
+/// draw is kept only so the name stays unpredictable to anything that can read
+/// the directory.
+pub(crate) fn unique_socket_name(prefix: &str, attempt: u32) -> String {
+    socket_name(prefix, std::process::id(), attempt)
+}
+
+fn socket_name(prefix: &str, pid: u32, attempt: u32) -> String {
+    format!("{prefix}{pid:x}-{attempt:x}-{:08x}.sock", fastrand::u32(..))
+}
+
+/// Restores the working directory the guard was built with when it is dropped.
+///
+/// The socket path in a container directory routinely exceeds the 108-byte
+/// `sun_path` limit, so binding and connecting are done from inside that
+/// directory under a relative name. That makes the working directory part of
+/// the operation, and an early return in the middle of one used to leave the
+/// process parked in the container directory, where every later relative path
+/// - the bundle-relative rootfs among them - resolves against the wrong root.
+struct CurrentDirGuard {
+    path: PathBuf,
+}
+
+impl Drop for CurrentDirGuard {
+    fn drop(&mut self) {
+        if let Err(err) = unistd::chdir(self.path.as_path()) {
+            tracing::warn!(path = ?self.path, ?err, "failed to restore the working directory");
+        }
+    }
+}
+
+/// Unlinks a per-invocation socket path when the invocation is finished with it.
+///
+/// The name is spent as soon as the start notification has been delivered, and
+/// the guard also covers the paths that leave through an error. Without it a
+/// container directory accumulated one dead socket per exec for as long as the
+/// container lived.
+pub(crate) struct ReservedSocketPath {
+    path: PathBuf,
+}
+
+impl ReservedSocketPath {
+    pub(crate) fn new(path: PathBuf) -> Self {
+        Self { path }
+    }
+
+    pub(crate) fn path(&self) -> &Path {
+        &self.path
+    }
+}
+
+impl Drop for ReservedSocketPath {
+    fn drop(&mut self) {
+        match std::fs::remove_file(&self.path) {
+            Ok(()) => {}
+            Err(err) if err.kind() == std::io::ErrorKind::NotFound => {}
+            Err(err) => {
+                tracing::warn!(path = ?self.path, ?err, "failed to remove reserved socket");
+            }
+        }
+    }
+}
