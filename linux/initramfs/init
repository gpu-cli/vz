#!/bin/busybox sh

set -eu

echo "[vz-init] booting initramfs"

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev || true
mount -t tmpfs tmpfs /tmp

mkdir -p /run /mnt/rootfs /mnt/merged

# Optional: pre-allocate memory in tmpfs at boot for memory-balloon testing.
# Honors `memhog_mb=N` on the kernel cmdline. Allocates N MB in /tmp (tmpfs)
# so the host actually backs the pages with real RAM, giving the balloon
# something to reclaim when the host calls set_target_memory_size().
# Defaults to 0 (no allocation) so this is invisible for normal boots.
memhog_mb=$(/bin/busybox sed -n 's/.*memhog_mb=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)
if [ -n "${memhog_mb:-}" ] && [ "${memhog_mb}" -gt 0 ] 2>/dev/null; then
  echo "[vz-init] allocating ${memhog_mb} MB into /tmp/memhog (balloon test fixture)"
  /bin/busybox dd if=/dev/zero of=/tmp/memhog bs=1M count="${memhog_mb}" 2>/dev/null || \
    echo "[vz-init] memhog allocation failed (continuing)"
fi

# Optional: just keep the kernel running idle for measurement runs that
# don't want the full guest-agent + youki setup. Set `vz_idle=1` on cmdline.
if /bin/busybox grep -q '\bvz_idle=1\b' /proc/cmdline; then
  echo "[vz-init] vz_idle=1 — dumping virtio device map, then polling meminfo"
  echo "[vz-init] /sys/bus/virtio/devices:"
  for d in /sys/bus/virtio/devices/*; do
    [ -d "$d" ] || continue
    dev=$(/bin/busybox cat "$d/device" 2>/dev/null || echo '?')
    drv=$(/bin/busybox readlink "$d/driver" 2>/dev/null || echo 'UNBOUND')
    echo "[vz-init]   $d  device=$dev  driver=$drv"
  done
  # Poll /proc/meminfo every 2s so the host can correlate balloon target
  # changes with guest-visible MemFree shifts.
  i=0
  while [ "$i" -lt 30 ]; do
    mt=$(/bin/busybox awk '/^MemTotal:/{print $2}' /proc/meminfo)
    mf=$(/bin/busybox awk '/^MemFree:/{print $2}' /proc/meminfo)
    ma=$(/bin/busybox awk '/^MemAvailable:/{print $2}' /proc/meminfo)
    echo "[vz-meminfo] t=${i}s MemTotal=${mt}kB MemFree=${mf}kB MemAvailable=${ma}kB"
    /bin/busybox sleep 2
    i=$((i + 2))
  done
  exec /bin/busybox sleep infinity
fi

# Create device nodes that devtmpfs may not auto-populate.
# /dev/kvm: needed for nested virtualization (Firecracker, QEMU).
# /dev/net/tun: needed for tap networking (Firecracker guest NICs).
# Check /proc/misc since sysfs misc class may not exist in minimal configs.
if grep -q ' kvm$' /proc/misc 2>/dev/null && [ ! -e /dev/kvm ]; then
  /bin/busybox mknod /dev/kvm c 10 232 2>/dev/null || true
fi
if grep -q ' tun$' /proc/misc 2>/dev/null && [ ! -e /dev/net/tun ]; then
  mkdir -p /dev/net
  /bin/busybox mknod /dev/net/tun c 10 200 2>/dev/null || true
fi

# Optional runtime binary share (host-provided youki artifact).
mkdir -p /mnt/oci-runtime-bin

install_youki_binary() {
  target_path="$1"
  if [ ! -f /mnt/oci-runtime-bin/youki ]; then
    return 0
  fi

  target_dir="${target_path%/*}"
  mkdir -p "$target_dir" || return 1
  cp /mnt/oci-runtime-bin/youki "$target_path" || return 1
  /bin/busybox chmod +x "$target_path" || return 1
  return 0
}

# The Developer profile carries a static legacy xtables multicall binary in the
# initramfs. Preserve it when entering an external overlay rootfs. Hardened
# guests do not contain the binary, so this remains a no-op for that profile.
install_iptables_binary() {
  target_root="$1"
  if [ ! -x /sbin/xtables-legacy-multi ]; then
    return 0
  fi

  mkdir -p "$target_root/sbin" || return 1
  cp /sbin/xtables-legacy-multi "$target_root/sbin/xtables-legacy-multi" || return 1
  /bin/busybox chmod +x "$target_root/sbin/xtables-legacy-multi" || return 1

  for command in iptables iptables-save iptables-restore ip6tables ip6tables-save ip6tables-restore; do
    /bin/busybox ln -sf /sbin/xtables-legacy-multi "$target_root/sbin/$command" || return 1
  done
  return 0
}

# The verified initramfs binds this canonical build-provenance JSON and both
# static tools. Preserve that exact payload across the overlay/chroot boundary;
# binaries outside the guest agent's root are not usable capabilities.
verify_developer_e2fsprogs() {
  e2_verify_root="$1"
  for e2_path in "$e2_verify_root" "$e2_verify_root/sbin" "$e2_verify_root/etc"; do
    [ -d "$e2_path" ] && [ ! -L "$e2_path" ] || return 1
  done
  e2_provenance="$e2_verify_root/etc/vz-e2fsprogs.json"
  [ -f "$e2_provenance" ] && [ ! -L "$e2_provenance" ] || return 1
  [ "$(/bin/busybox stat -c '%h' "$e2_provenance")" = 1 ] || return 1
  for e2_name in mke2fs dumpe2fs; do
    e2_path="$e2_verify_root/sbin/$e2_name"
    [ -f "$e2_path" ] && [ ! -L "$e2_path" ] && [ -x "$e2_path" ] || return 1
    [ "$(/bin/busybox stat -c '%h' "$e2_path")" = 1 ] || return 1
    # Only the helper's canonical JSON binary fields are accepted. Multiple,
    # missing, empty, malformed or redirected records cannot validate a tool.
    e2_expected=$(/bin/busybox sed -n "s/^    \"$e2_name\": \"\([0-9a-f]*\)\"[,]\{0,1\}$/\1/p" "$e2_provenance") || return 1
    [ "${#e2_expected}" = 64 ] || return 1
    case "$e2_expected" in *[!0-9a-f]*) return 1 ;; esac
    e2_observed=$(/bin/busybox sha256sum "$e2_path") || return 1
    [ "${e2_observed%% *}" = "$e2_expected" ] || return 1
  done
}

install_developer_e2fsprogs() {
  e2_origin=/
  e2_target_root="$1"
  verify_developer_e2fsprogs "$e2_origin" || return 1
  [ -d "$e2_target_root" ] && [ ! -L "$e2_target_root" ] || return 1
  for e2_path in "$e2_target_root/sbin" "$e2_target_root/etc"; do
    [ ! -L "$e2_path" ] || return 1
    if [ -e "$e2_path" ]; then [ -d "$e2_path" ] || return 1; fi
    /bin/busybox mkdir -p "$e2_path" || return 1
  done
  for e2_relative in sbin/mke2fs sbin/dumpe2fs etc/vz-e2fsprogs.json; do
    e2_target="$e2_target_root/$e2_relative"
    [ ! -L "$e2_target" ] || return 1
    if [ -e "$e2_target" ]; then
      [ -f "$e2_target" ] && [ "$(/bin/busybox stat -c '%h' "$e2_target")" = 1 ] || return 1
      /bin/busybox cmp "$e2_origin/$e2_relative" "$e2_target" || return 1
    else
      /bin/busybox cp "$e2_origin/$e2_relative" "$e2_target" || return 1
    fi
  done
  /bin/busybox chmod 755 "$e2_target_root/sbin/mke2fs" "$e2_target_root/sbin/dumpe2fs" || return 1
  /bin/busybox chmod 444 "$e2_target_root/etc/vz-e2fsprogs.json" || return 1
  verify_developer_e2fsprogs "$e2_target_root"
}

# The Developer image's certificate-verifying HTTPS client.
#
# It has to be carried across the overlay/chroot boundary for the same reason
# every other static tool does: `vz exec` runs inside the chroot, and a binary
# left behind in the initramfs is not a capability any Machine has. It is
# installed beside the pinned CA bundle that `install_developer_ca_trust` puts
# in the same root, because that bundle is the client's default trust store and
# a client without one fails closed on every fetch.
install_developer_https_client() {
  hc_origin=/usr/bin/vz-guest-fetch
  hc_root="$1"
  [ -f "$hc_origin" ] && [ ! -L "$hc_origin" ] || return 1
  [ -d "$hc_root" ] && [ ! -L "$hc_root" ] || return 1
  hc_target_dir="$hc_root/usr/local/bin"
  [ ! -L "$hc_target_dir" ] || return 1
  if [ -e "$hc_target_dir" ]; then [ -d "$hc_target_dir" ] || return 1; fi
  /bin/busybox mkdir -p "$hc_target_dir" || return 1
  hc_target="$hc_target_dir/vz-guest-fetch"
  # A path the external image already occupies is not overwritten silently: the
  # copy is only accepted when it is byte-identical to the one this initramfs
  # verified, so an image cannot substitute its own client for this one.
  [ ! -L "$hc_target" ] || return 1
  if [ -e "$hc_target" ]; then
    [ -f "$hc_target" ] || return 1
    /bin/busybox cmp "$hc_origin" "$hc_target" || return 1
  else
    /bin/busybox cp "$hc_origin" "$hc_target" || return 1
  fi
  /bin/busybox chmod 555 "$hc_target" || return 1
  [ -x "$hc_target" ] || return 1
}

# Developer trust is a pinned public bundle in this verified initramfs, not
# host trust or the build container's CA directory. Hardened has neither the
# Developer xtables marker nor CA payload. Integrity failure is terminal.
if [ -x /sbin/xtables-legacy-multi ]; then
  if ! verify_developer_e2fsprogs /; then
    echo "[vz-init] Developer ext4 tooling integrity failed"
    exit 1
  fi
  if [ ! -f /etc/vz/install-ca-trust.sh ] || [ -L /etc/vz/install-ca-trust.sh ]; then
    echo "[vz-init] missing or redirected Developer CA installer"
    exit 1
  fi
  . /etc/vz/install-ca-trust.sh
  if ! verify_developer_ca_trust; then
    echo "[vz-init] Developer CA trust integrity failed"
    exit 1
  fi
  # Go otherwise scans additional conventional trust directories even after
  # loading the pinned bundle. Select only this bundle and a verified empty dir.
  export SSL_CERT_FILE=/etc/vz/ca-certificates.crt
  export SSL_CERT_DIR=/etc/vz/empty-ca-directory
fi

# Ensure loopback works for localhost services and port forwarding.
/bin/ip link set dev lo up >/dev/console 2>&1 || true


# Optional DHCP setup if a virtio-net device is present.
# Run in background so missing network does not block guest-agent startup.
#
# `vz.nat=1` says the host attached Apple's NAT NIC. It has to say so, because
# a single `[ -d /sys/class/net/eth0 ]` cannot distinguish a device that is
# still being probed from one that was never attached, and virtio-net probing
# is ASYNCHRONOUS -- the same race `find_fabric_nic` below waits out. Without
# the parameter the wait would have to be unconditional, and a Machine with
# `offline` egress has no NAT NIC by design, so every offline boot would pay
# the whole budget for a device that is never coming.
#
# Measured: with the NIC attached and no wait, the guest reached the agent with
# eth0 present and empty --
#   base eth0 did not acquire an IPv4 address and default route:
#   stdout="address:\n\nroutes:\n\n"
# which is a Machine that believes it has egress and has none.
# --- BEGIN vz.nat NIC wait (extracted verbatim by vz-linux tests) ---
VZ_NAT_NIC_WAIT_SECONDS=20
vz_nat_declared=0
for vz_param in $(/bin/busybox cat /proc/cmdline); do
  [ "$vz_param" = "vz.nat=1" ] && vz_nat_declared=1
done
if [ "$vz_nat_declared" = 1 ]; then
  vz_nat_waited=0
  while [ ! -d /sys/class/net/eth0 ] && [ "$vz_nat_waited" -lt "$VZ_NAT_NIC_WAIT_SECONDS" ]; do
    /bin/busybox sleep 1
    vz_nat_waited=$((vz_nat_waited + 1))
  done
  if [ ! -d /sys/class/net/eth0 ]; then
    echo "[vz-init] warning: vz.nat=1 but no eth0 after ${VZ_NAT_NIC_WAIT_SECONDS}s" >/dev/console
  fi
fi
# --- END vz.nat NIC wait ---
if [ -d /sys/class/net/eth0 ] && [ -x /sbin/udhcpc ]; then
  /bin/ip link set dev eth0 up >/dev/console 2>&1 || true
  /sbin/udhcpc -i eth0 -s /etc/udhcpc.script -q -b -t 5 -T 1 >/dev/console 2>&1 &
fi

# --- BEGIN vz.net fabric ports (extracted verbatim by vz-linux tests) ---
# Configure every Environment-network port named on the kernel cmdline.
#
# Each `vz.net.N=<mac>,<addr>/<prefix>[,<gw>]` is one port on an Environment
# switch. The address is derived on the host from persisted records and cannot
# be discovered from in here: there is no DHCP server on a fabric, by design,
# because a Machine that stops and comes back must present the address its
# switch and its own saved state already expect. It also has to be live before
# the guest agent starts, which is why it arrives on the cmdline and not over
# an RPC. Configuration is therefore reboot-only.
#
# The interface is found by MAC and never by name. Interface enumeration order
# is not guaranteed, so the host cannot predict which name this NIC gets, while
# the MAC is exactly what the host configured the NIC with. Matching on it also
# means eth0 is untouched: eth0 is the default NAT NIC and its address is never
# a fabric port's.
# How long to wait for a fabric NIC to appear in sysfs, in whole seconds.
#
# virtio-net devices are probed ASYNCHRONOUSLY, so a scan that runs before the
# probe completes finds nothing -- and this configuration is reboot-only, so
# "nothing" is permanent. The Machine then boots, starts its guest agent, and
# reports ready with no fabric NIC at all: the address is on the cmdline and
# there is no interface to put it on.
#
# Measured: two of two full topology-lane runs hit exactly that, while the same
# check passed twice standalone. The difference is host load, which is what
# moves a device probe past a single unwaited scan.
#
# Whole seconds because fractional `sleep` is a BusyBox build option this image
# does not guarantee, and the applet list in linux/Makefile promises only
# `sleep` itself. The budget is generous because the cost of exhausting it is a
# refused boot and the cost of being too short is a Machine that silently has
# no network.
VZ_FABRIC_NIC_WAIT_SECONDS=20
# Every declared fabric port this boot could NOT configure, one `vz.net.N`
# parameter per line. Absent or empty means every declared port came up.
# Readiness reads it and refuses the Machine rather than publishing a Machine
# that is not on the network its definition declares.
VZ_FABRIC_UNCONFIGURED=/run/vz-fabric-unconfigured

# The interface whose MAC is `$1`, waited for rather than sampled.
#
# Prints the interface name and returns 0, or prints nothing and returns 1 once
# the budget is spent. The FIRST scan happens before any sleep, so a healthy
# boot -- where the device is already there -- pays nothing and uses no applet
# beyond `cat`.
find_fabric_nic() {
  ffn_mac="$1"
  ffn_waited=0
  while : ; do
    # The host lowercases the MAC before it reaches the cmdline and sysfs is
    # lowercase by kernel convention, so both sides compare without a case fold
    # and without depending on a `tr` applet being compiled into this BusyBox.
    for ffn_path in /sys/class/net/*; do
      [ -r "$ffn_path/address" ] || continue
      ffn_found=$(/bin/busybox cat "$ffn_path/address" 2>/dev/null)
      if [ "$ffn_found" = "$ffn_mac" ]; then
        echo "${ffn_path##*/}"
        return 0
      fi
    done
    [ "$ffn_waited" -lt "$VZ_FABRIC_NIC_WAIT_SECONDS" ] || return 1
    /bin/busybox sleep 1
    ffn_waited=$((ffn_waited + 1))
  done
}

configure_fabric_nic() {
  cfn_mac="$1"
  cfn_cidr="$2"
  cfn_gateway="$3"
  cfn_iface=$(find_fabric_nic "$cfn_mac")
  if [ -z "$cfn_iface" ]; then
    echo "[vz-init] no interface has address $cfn_mac after ${VZ_FABRIC_NIC_WAIT_SECONDS}s; fabric port left unconfigured"
    return 1
  fi
  /bin/busybox ip address add "$cfn_cidr" dev "$cfn_iface" || return 1
  /bin/busybox ip link set dev "$cfn_iface" up || return 1
  if [ -n "$cfn_gateway" ]; then
    # A fabric gateway is the egress path for NetworkKind::SimulatedPublic,
    # so it is a default route rather than an on-link one. Nothing emits a
    # gateway yet; when egress lands it must also settle which NIC owns the
    # default route, because udhcpc may install one for eth0 from Apple's NAT.
    /bin/busybox ip route add default via "$cfn_gateway" dev "$cfn_iface" || return 1
  fi
  echo "[vz-init] fabric port $cfn_iface ($cfn_mac) $cfn_cidr${cfn_gateway:+ via $cfn_gateway}"
  return 0
}

configure_fabric_ports_from_cmdline() {
  for cfp_param in $(/bin/busybox cat /proc/cmdline); do
    case "$cfp_param" in
      vz.net.*=*)
        cfp_value="${cfp_param#*=}"
        cfp_mac="${cfp_value%%,*}"
        cfp_rest="${cfp_value#*,}"
        cfp_cidr="${cfp_rest%%,*}"
        case "$cfp_rest" in
          *,*) cfp_gateway="${cfp_rest#*,}" ;;
          *) cfp_gateway="" ;;
        esac
        # A DECLARED fabric port that could not be applied is recorded where
        # readiness can see it, not just printed. The definition said this
        # Machine is on that network; handing it back `ready` with no address
        # on it makes every later denial and reachability claim about it a lie,
        # and the failure then surfaces as some unrelated "Network is
        # unreachable" much further downstream.
        if ! configure_fabric_nic "$cfp_mac" "$cfp_cidr" "$cfp_gateway"; then
          echo "[vz-init] warning: could not apply $cfp_param"
          /bin/busybox mkdir -p "${VZ_FABRIC_UNCONFIGURED%/*}" 2>/dev/null
          echo "$cfp_param" >> "$VZ_FABRIC_UNCONFIGURED"
        fi
        ;;
    esac
  done
}

configure_fabric_ports_from_cmdline >/dev/console 2>&1 || true
# --- END vz.net fabric ports ---

# --- BEGIN vz.host endpoint names (extracted verbatim by vz-linux tests) ---
# Resolve every declared Environment endpoint name to its owning Machine's
# fabric address.
#
# Each `vz.host.{N}={ipv4},{name}` is one declared endpoint, already resolved on
# the host from the same persisted records the addresses above come from, and
# already scoped to the networks this Machine holds a port on. Resolution is all
# this is: nothing here binds a listener, probes the port or waits for one, so a
# name appearing below is not evidence that anything answers on it.
#
# It is a file and not a resolver because a fabric address is derived rather
# than leased and therefore never changes while the Machine lives, so there is
# nothing for a resolver to be authoritative about that the cmdline does not
# already state. The same reasoning makes it reboot-only, exactly like the port
# configuration above.
fabric_hosts_are_declared() {
  for fhd_param in $(/bin/busybox cat /proc/cmdline); do
    case "$fhd_param" in
      vz.host.*=*) return 0 ;;
    esac
  done
  return 1
}

# `$1` is a root *prefix*, not a directory to descend into: the empty string
# writes this initramfs' own /etc/hosts and "$ROOTFS" writes the overlay root
# the guest agent is later chroot'd into. Both are written, because which of
# them the Machine ends up running in is decided after this point.
write_fabric_hosts() {
  wfh_root="$1"
  # A Machine with no declared endpoint keeps whatever /etc/hosts its image
  # shipped. Truncating that to a generated file would be a regression for
  # every Machine that declares no endpoint at all, which is most of them.
  fabric_hosts_are_declared || return 0
  {
    echo "127.0.0.1 localhost"
    echo "::1 localhost"
  } > "$wfh_root/etc/hosts" || return 1
  for wfh_param in $(/bin/busybox cat /proc/cmdline); do
    case "$wfh_param" in
      vz.host.*=*)
        wfh_value="${wfh_param#*=}"
        case "$wfh_value" in
          *,*) ;;
          # Malformed rather than merely unmatched: emitting the two halves of
          # a value that has no comma would write a line naming an address that
          # is also its own hostname, which resolves and resolves wrongly.
          *) echo "[vz-init] ignoring malformed $wfh_param"; continue ;;
        esac
        echo "${wfh_value%%,*} ${wfh_value#*,}" >> "$wfh_root/etc/hosts" || return 1
        ;;
    esac
  done
  echo "[vz-init] declared endpoint names resolved in $wfh_root/etc/hosts"
  return 0
}

write_fabric_hosts "" >/dev/console 2>&1 || \
  echo "[vz-init] warning: could not write endpoint names into /etc/hosts" >/dev/console 2>&1
# --- END vz.host endpoint names ---

# --- BEGIN vz.dns resolver (extracted verbatim by vz-linux tests) ---
# Point this Machine at its Environment's own resolver.
#
# Each `vz.dns.{N}={ipv4}` names the edge of a public-like network this Machine
# holds a port on. Unlike the names above, these are not resolved on the host
# and written down here: a public-like name answers with the edge's address and
# is answered by the edge, which is what makes it an ingress path rather than a
# direct route to the Machine behind it.
#
# The image's resolv.conf is replaced, not added to. The Environment's resolver
# is authoritative for the Environment's names and answers nothing else, and a
# public resolver left beside it would be asked for an Environment name the
# moment the first query came back unanswered -- which is exactly the split the
# declaration asked not to have. A Machine with no `vz.dns` argument keeps
# whatever resolv.conf its image shipped.
#
# `$1` is a root *prefix*, exactly as for the hosts table above, and for the
# same reason: which root the Machine ends up running in is decided later.
write_fabric_resolver() {
  wfr_root="$1"
  wfr_written=0
  for wfr_param in $(/bin/busybox cat /proc/cmdline); do
    case "$wfr_param" in
      vz.dns.*=*)
        wfr_value="${wfr_param#*=}"
        # An empty value would write a nameserver line naming nothing, which
        # resolves nothing and hides the fact that the argument was malformed.
        if [ -z "$wfr_value" ]; then
          echo "[vz-init] ignoring malformed $wfr_param"
          continue
        fi
        if [ "$wfr_written" = 0 ]; then
          : > "$wfr_root/etc/resolv.conf" || return 1
          wfr_written=1
        fi
        echo "nameserver $wfr_value" >> "$wfr_root/etc/resolv.conf" || return 1
        ;;
    esac
  done
  if [ "$wfr_written" = 1 ]; then
    echo "[vz-init] Environment resolver written to $wfr_root/etc/resolv.conf"
    return 0
  fi
  # No declared resolver: the file exists and names no nameserver.
  #
  # It used to simply not exist, and nothing noticed, because every Machine
  # also had a NAT NIC whose `udhcpc` wrote one as a side effect. That was
  # never a declared behaviour -- nobody had decided the Machine should have a
  # resolver, it just came with an attachment nobody had decided to withhold.
  # Enforcing `EgressPolicy::Offline` removed the attachment, and readers
  # started getting ENOENT.
  #
  # Empty rather than absent, because the two say different things. An empty
  # resolv.conf is "asked, and there is no nameserver to ask" -- which is the
  # truth for an offline Machine with no declared resolver, and what every
  # resolver library is built to handle. A missing file is "this image is
  # broken", and a caller cannot tell that from a Machine that was never
  # configured.
  if [ -e "$wfr_root/etc/resolv.conf" ]; then
    return 0
  fi
  : > "$wfr_root/etc/resolv.conf" || return 1
  echo "[vz-init] no declared resolver; wrote an empty $wfr_root/etc/resolv.conf"
  return 0
}

write_fabric_resolver "" >/dev/console 2>&1 || \
  echo "[vz-init] warning: could not write the Environment resolver into /etc/resolv.conf" >/dev/console 2>&1
# --- END vz.dns resolver ---

switch_root_into_overlay_rootfs() {
  echo "[vz-init] preparing overlay rootfs"

  mkdir -p /run/vz-oci/overlay || return 1
  mount -t tmpfs tmpfs /run/vz-oci || return 1
  mkdir -p /run/vz-oci/overlay/upper /run/vz-oci/overlay/work || return 1
  mount -t overlay overlay \
    -o lowerdir=/mnt/rootfs,upperdir=/run/vz-oci/overlay/upper,workdir=/run/vz-oci/overlay/work \
    /mnt/merged || return 1

  ROOTFS=/mnt/merged

  mkdir -p "$ROOTFS/proc" "$ROOTFS/sys" "$ROOTFS/dev" "$ROOTFS/tmp" "$ROOTFS/run" || return 1
  mkdir -p "$ROOTFS/usr/local/bin" "$ROOTFS/etc" || return 1

  mount -t proc proc "$ROOTFS/proc" || return 1
  mount -t sysfs sysfs "$ROOTFS/sys" || return 1
  mount -t devtmpfs devtmpfs "$ROOTFS/dev" || true
  mount -t tmpfs tmpfs "$ROOTFS/tmp" || return 1

  # Create device nodes that devtmpfs may not auto-populate in the chroot.
  if grep -q ' kvm$' /proc/misc 2>/dev/null && [ ! -e "$ROOTFS/dev/kvm" ]; then
    /bin/busybox mknod "$ROOTFS/dev/kvm" c 10 232 2>/dev/null || true
  fi
  if grep -q ' tun$' /proc/misc 2>/dev/null && [ ! -e "$ROOTFS/dev/net/tun" ]; then
    mkdir -p "$ROOTFS/dev/net"
    /bin/busybox mknod "$ROOTFS/dev/net/tun" c 10 200 2>/dev/null || true
  fi

  # Mount cgroup2 for OCI container runtime (youki) support.
  mkdir -p "$ROOTFS/sys/fs/cgroup"
  mount -t cgroup2 none "$ROOTFS/sys/fs/cgroup" || true

  cp /usr/bin/vz-guest-agent "$ROOTFS/usr/local/bin/vz-guest-agent" || return 1
  /bin/busybox chmod +x "$ROOTFS/usr/local/bin/vz-guest-agent" || return 1

  if [ ! -f "$ROOTFS/etc/resolv.conf" ]; then
    cp /etc/resolv.conf "$ROOTFS/etc/resolv.conf" || return 1
  fi
  cp /etc/udhcpc.script "$ROOTFS/etc/udhcpc.script" || return 1
  /bin/busybox chmod +x "$ROOTFS/etc/udhcpc.script" || return 1

  # The Machine's own /etc/hosts, in the root it will actually run in. This is
  # the same write as the one above the switch_root and not a copy of its
  # result, so the overlay root's file does not depend on the initramfs write
  # having succeeded. It is written from here rather than by the guest agent
  # because it must already be true when the agent starts: the agent is what
  # `vz exec` runs through, so a name it populated after coming up would be
  # unresolvable for exactly the first commands anyone runs. Writing into
  # "$ROOTFS/etc" from the initramfs is the same move the resolv.conf copy
  # above makes and works for the same reason — this is a plain write into the
  # overlay's upperdir from the mount namespace that then chroots, with no
  # VirtioFS layer and no pivot_root between the write and the reader.
  write_fabric_resolver "$ROOTFS" || \
    echo "[vz-init] warning: could not write the Environment resolver into $ROOTFS/etc/resolv.conf"
  write_fabric_hosts "$ROOTFS" || \
    echo "[vz-init] warning: could not write endpoint names into $ROOTFS/etc/hosts"

  install_youki_binary "$ROOTFS/usr/local/bin/youki" || return 1
  install_youki_binary "$ROOTFS/run/vz-oci/bin/youki" || return 1

  # Copy busybox into rootfs for network setup commands.
  mkdir -p "$ROOTFS/bin" "$ROOTFS/sbin"
  cp /bin/busybox "$ROOTFS/bin/busybox" || return 1
  install_iptables_binary "$ROOTFS" || return 1
  if [ -x /sbin/xtables-legacy-multi ] && ! install_developer_e2fsprogs "$ROOTFS"; then
    echo "[vz-init] Developer overlay ext4 tooling installation failed"
    exit 1
  fi
  if [ -x /sbin/xtables-legacy-multi ] && ! install_developer_ca_trust "$ROOTFS"; then
    # Do not fall back to a different rootfs after rejecting unsafe trust paths.
    echo "[vz-init] Developer overlay CA trust installation failed"
    exit 1
  fi
  # Terminal for the same reason the trust install is: a Developer Machine that
  # came up without its HTTPS client would report every https fetch as "no such
  # file", which is indistinguishable from a network that does not carry.
  if [ -x /sbin/xtables-legacy-multi ] && ! install_developer_https_client "$ROOTFS"; then
    echo "[vz-init] Developer overlay HTTPS client installation failed"
    exit 1
  fi
  # Install applet symlinks using busybox's built-in mechanism.
  # Manual `ln -sf` fails on some overlayfs configurations.
  chroot "$ROOTFS" /bin/busybox --install -s /bin 2>/dev/null || \
    /bin/busybox --install -s "$ROOTFS/bin" 2>/dev/null || true

  # Bind-mount VirtioFS rootfs share directly into chroot so container
  # rootfs directories written after overlay mount are visible.
  # Overlay caches lowerdir entries, so new files added via VirtioFS
  # won't appear through the overlay — but a direct bind mount works.
  mkdir -p "$ROOTFS/vz-rootfs"
  mount --bind /mnt/rootfs "$ROOTFS/vz-rootfs" || return 1

  # Bind-mount VirtioFS volume shares (vz-mount-*) into the chroot.
  # Container OCI bundles reference /mnt/vz-mount-N as bind mount sources.
  # Without these bind mounts, youki can't find the VirtioFS shares
  # from inside the chroot.
  vidx=0
  while true; do
    vtag="vz-mount-$vidx"
    vsrc="/mnt/$vtag"
    vdst="$ROOTFS/mnt/$vtag"
    if [ -d "$vsrc" ]; then
      mkdir -p "$vdst"
      mount --bind "$vsrc" "$vdst" || \
        echo "[vz-init] warning: failed to bind-mount $vsrc to $vdst"
      echo "[vz-init] chroot bind-mount $vsrc -> /mnt/$vtag"
      vidx=$((vidx + 1))
    else
      break
    fi
  done

  # Bind-mount user volume shares into the chroot at their target paths.
  # Target paths are encoded in kernel cmdline as vz.mount.N=/target/path.
  for param in $(cat /proc/cmdline); do
    case "$param" in
      vz.mount.*=*)
        idx="${param#vz.mount.}"
        idx="${idx%%=*}"
        target="${param#*=}"
        src="/mnt/vz-mount-$idx"
        if [ -d "$src" ]; then
          mkdir -p "$ROOTFS$target"
          mount --bind "$src" "$ROOTFS$target" || \
            echo "[vz-init] warning: failed to bind-mount $src to $ROOTFS$target"
          echo "[vz-init] volume $src -> $target"
        fi
        ;;
    esac
  done

  echo "[vz-init] entering rootfs via chroot and starting guest agent on vsock 7424"

  # Run guest agent as a child process (not PID 1) to avoid OOM killer deadlock.
  # PID 1 is unkillable; if the agent triggers OOM as PID 1, the kernel panics.
  chroot "$ROOTFS" /usr/local/bin/vz-guest-agent --port 7424 --bind-timeout-secs 30 &
  wait

  return 1
}

ROOTFS_READY=0

# Optional VirtioFS rootfs mount (used by container runtime path).
if mount -t virtiofs rootfs /mnt/rootfs 2>/dev/null; then
  echo "[vz-init] mounted virtiofs rootfs at /mnt/rootfs"
  # Note: we do NOT remount /mnt/rootfs read-only here. Overlay works fine
  # with an rw lowerdir (writes go to upperdir, lowerdir is never modified
  # through the overlay). Keeping /mnt/rootfs rw allows the bind mount at
  # /vz-rootfs to also be rw, which the OCI runtime needs for container setup.
  ROOTFS_READY=1
else
  echo "[vz-init] no rootfs virtiofs mount available, continuing"
fi

if mount -t virtiofs oci-runtime-bin /mnt/oci-runtime-bin 2>/dev/null; then
  echo "[vz-init] mounted virtiofs oci-runtime-bin at /mnt/oci-runtime-bin"
else
  echo "[vz-init] no oci-runtime-bin virtiofs mount available"
fi

# Mount user-provided VirtioFS volume shares (vz-mount-0, vz-mount-1, ...).
# These are configured when --volume is passed to `vz oci run`.
idx=0
while true; do
  tag="vz-mount-$idx"
  mount_point="/mnt/$tag"
  mkdir -p "$mount_point"
  if mount -t virtiofs "$tag" "$mount_point" 2>/dev/null; then
    echo "[vz-init] mounted virtiofs $tag at $mount_point"
  else
    # No more mount shares — stop probing.
    rmdir "$mount_point" 2>/dev/null || true
    break
  fi
  idx=$((idx + 1))
done

if ! install_youki_binary /usr/local/bin/youki; then
  echo "[vz-init] failed to stage youki in initramfs userland"
fi

if [ "$ROOTFS_READY" -eq 1 ]; then
  if ! switch_root_into_overlay_rootfs; then
    echo "[vz-init] rootfs setup failed, falling back to initramfs userland"
  fi
fi

echo "[vz-init] starting guest agent on vsock 7424"
/usr/bin/vz-guest-agent --port 7424 &
wait
