ARG FIXTURE_BASE
FROM ${FIXTURE_BASE} AS build
ARG FIXTURE_BASE
ARG FIXTURE_SECRET_SHA256
COPY tools.py /fixture/tools.py
RUN --network=none --mount=type=secret,id=fixture,required=true python3 /fixture/tools.py secret
RUN --network=none test ! -e /run/secrets/fixture
FROM scratch AS output
COPY --from=build /out/secret.txt /secret.txt
