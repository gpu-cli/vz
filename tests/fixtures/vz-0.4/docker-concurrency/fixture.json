{
  "concurrent_clients": {
    "all_results_exact_owner_correlated": true,
    "parallel_builds": 4,
    "parallel_execs": 8,
    "parallel_pulls": 4,
    "ready_containers": 20,
    "ready_window_seconds": 60
  },
  "image": "developer-probe-rootfs.tar imported by the harness sentinel; the pull recipe uses its own owned private registry",
  "probe": {
    "bytes": 1026,
    "cases": [
      "ready",
      "report"
    ],
    "exec_template": "VZEXEC {marker} {slot} {arrived} {waited}",
    "health_command_template": "/bin/busybox grep -qx 'VZREADY {marker}' /run/vz-concurrency-ready",
    "interpreter": [
      "/bin/busybox",
      "sh",
      "-c"
    ],
    "path": "probe.sh",
    "ready_path": "/run/vz-concurrency-ready",
    "ready_template": "VZREADY {marker}",
    "rendezvous_path": "/vz-rendezvous",
    "sha256": "4da8a15ffc67d092644ef7565478de89417fcccce9ddcde6e8b747a031c1e7fb"
  },
  "pull_registry": {
    "accesslog_disabled": false,
    "accesslog_stream": "stdout (Apache combined); JSON application log with http.response.duration on stderr",
    "container_port": 5000,
    "insecure_by_default_cidr": "127.0.0.0/8",
    "layer_bytes": 2097152,
    "listen": "0.0.0.0:5000",
    "published_host_ip": "127.0.0.1",
    "repositories": 4,
    "scheme": "http",
    "storage_rootdirectory": "/var/lib/registry"
  },
  "schema_version": 1,
  "scope": "DEV_DOCKER_CONCURRENCY_FIXTURE_NOT_DOCKER_CERTIFICATION"
}
