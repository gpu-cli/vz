ARG FIXTURE_BASE=docker.io/library/python@sha256:d04f49f5882f49a3b91f874e75e19f0c265f7222da8659741a9d7eab148f22a9
FROM ${FIXTURE_BASE} AS build
ARG FIXTURE_BASE
ARG FIXTURE_RUN
ARG FIXTURE_SLOT
COPY parallel.py /fixture/parallel.py
RUN --network=none --mount=type=cache,id=vz04-parallel-barrier-v1,target=/barrier,sharing=shared python3 /fixture/parallel.py
FROM scratch AS output
COPY --from=build /out/payload.txt /payload.txt
