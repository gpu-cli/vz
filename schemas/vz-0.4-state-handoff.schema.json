{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vz 0.4 clean-provision state handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_tuple_sha256",
    "complete",
    "kind",
    "lanes",
    "phase",
    "produced_at_utc",
    "run_id",
    "schema_version",
    "sentinels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vz-0.4-state-handoff"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "phase": {
      "const": "clean-provision"
    },
    "produced_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "candidate_tuple_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "complete": {
      "type": "boolean"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "outcome",
          "produced",
          "produced_sha256"
        ],
        "properties": {
          "lane": {
            "enum": [
              "sandbox-vm",
              "topology",
              "linux-docker",
              "native-macos"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "produced": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$"
          },
          "produced_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sentinels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "path",
          "sha256"
        ],
        "properties": {
          "lane": {
            "enum": [
              "sandbox-vm",
              "topology",
              "linux-docker",
              "native-macos"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "sentinels": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
