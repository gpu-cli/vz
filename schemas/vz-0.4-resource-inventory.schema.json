{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vz 0.4 host resource inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_state",
    "captured_at_utc",
    "docker_contexts",
    "interfaces",
    "kind",
    "listeners",
    "moment",
    "not_captured_reason",
    "processes",
    "run_id",
    "schema_version",
    "sockets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vz-0.4-resource-inventory"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "moment": {
      "enum": [
        "before",
        "after"
      ]
    },
    "capture_state": {
      "enum": [
        "not_captured",
        "captured"
      ]
    },
    "captured_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "not_captured_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "listeners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "command",
          "pid",
          "port",
          "protocol"
        ],
        "properties": {
          "protocol": {
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "address": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "pid"
        ],
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "addresses",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sockets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^/[^\\r\\n\\x00]*$"
      }
    },
    "docker_contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "captured"
          }
        }
      },
      "then": {
        "properties": {
          "not_captured_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_state": {
            "const": "not_captured"
          }
        }
      },
      "then": {
        "properties": {
          "not_captured_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
