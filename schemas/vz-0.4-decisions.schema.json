{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vz 0.4 scope/exclusion decisions (frozen input)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "decisions",
    "kind",
    "schema_version",
    "signature_namespace",
    "signatures_dir",
    "target_release"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/vz-0.4-decisions.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vz-0.4-decisions"
    },
    "target_release": {
      "const": "0.4.0"
    },
    "signature_namespace": {
      "const": "vz-0.4-decision"
    },
    "signatures_dir": {
      "const": "config/vz-0.4-decision-signatures"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval",
          "effective_commit",
          "id",
          "kind",
          "rationale",
          "signature",
          "source_reference",
          "subject"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dec-[0-9]{4}$"
          },
          "kind": {
            "enum": [
              "scope",
              "exclusion",
              "tolerance_change",
              "envelope_change",
              "waiver_refusal"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "source_reference": {
            "type": "string",
            "minLength": 1
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approved_at_utc",
              "key_id",
              "principal"
            ],
            "properties": {
              "key_id": {
                "type": "string",
                "pattern": "^vz04-[a-z0-9-]+$"
              },
              "principal": {
                "type": "string",
                "minLength": 1
              },
              "approved_at_utc": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          },
          "effective_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "signature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "file",
              "namespace",
              "signed_sha256"
            ],
            "properties": {
              "algorithm": {
                "const": "ssh-ed25519"
              },
              "namespace": {
                "const": "vz-0.4-decision"
              },
              "file": {
                "type": "string",
                "pattern": "^config/vz-0\\.4-decision-signatures/dec-[0-9]{4}\\.sig$"
              },
              "signed_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
