{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vz 0.4 command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "argv",
    "canary_withheld",
    "cwd",
    "effects_uncertain",
    "ended_unix_ns",
    "error",
    "executable",
    "exit_code",
    "index",
    "kind",
    "label",
    "not_executed_reason",
    "run_id",
    "schema_version",
    "started_unix_ns",
    "state",
    "stderr_path",
    "stderr_sha256",
    "stdout_path",
    "stdout_sha256",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vz-0.4-receipt"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "pattern": "^/[^\\r\\n\\x00]*$"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "intent",
        "completed",
        "not_executed",
        "error"
      ]
    },
    "started_unix_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ended_unix_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "stdout_path": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$"
    },
    "stderr_path": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$"
    },
    "stdout_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "stderr_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "effects_uncertain": {
      "type": "boolean"
    },
    "canary_withheld": {
      "type": "boolean"
    },
    "not_executed_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "integer"
          },
          "ended_unix_ns": {
            "type": "integer",
            "minimum": 0
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "error": {
            "type": "null"
          },
          "not_executed_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "not_executed"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "type": "null"
          },
          "not_executed_reason": {
            "type": "string",
            "minLength": 1
          },
          "effects_uncertain": {
            "const": false
          }
        }
      }
    }
  ]
}
