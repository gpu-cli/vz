{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vz 0.4 append-only aggregate run index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries",
    "kind",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "vz-0.4-run-index"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_tuple_sha256",
          "developer_overrides",
          "evidence_dir",
          "run_id",
          "started_at_utc",
          "verdict"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
          },
          "candidate_tuple_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "started_at_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "evidence_dir": {
            "type": "string",
            "pattern": "^/[^\\r\\n\\x00]*$"
          },
          "verdict": {
            "enum": [
              "running",
              "PASS",
              "FAIL"
            ]
          },
          "developer_overrides": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "dry_lanes"
              ]
            }
          }
        }
      }
    }
  }
}
